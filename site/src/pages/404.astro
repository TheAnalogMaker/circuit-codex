---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Circuit Codex"
      description="That address is not a page on Circuit Codex. The circuit index, the lineage tree, and search are still here.">
<div class="wrap">
  <header class="page-head">
    <h1>Nothing at this address.</h1>
    <p class="lede">The archive moves by adding circuits, not by renaming them — if a
      link brought you here, the page was never published, or the address is a typo.
      These are the usual ways back in.</p>
  </header>
  <ul class="ways">
    <li><a href="/#circuits">Circuit index</a></li>
    <li><a href="/search/">Search the archive</a></li>
    <li><a href="/lineage/">Lineage tree</a></li>
    <li><a href="/reference/">Reference &amp; labs</a></li>
    <li><a href="/about/">About &amp; how to contribute</a></li>
  </ul>
</div>
</Base>

<style>
  .page-head{padding:72px 0 12px}
  h1{font-size:clamp(28px,4vw,42px);margin:0 0 14px}
  .lede{max-width:60ch;color:var(--muted);font-size:17px}
  .ways{list-style:none;margin:28px 0 80px;padding:0;display:flex;flex-direction:column;gap:10px}
  .ways a{font-family:var(--disp);text-transform:uppercase;letter-spacing:.1em;font-size:15px}
</style>
