---
import Base from '../../layouts/Base.astro';
import { loadHistory, displayId, wantedCircuitUrl, issueSearchUrl, GITHUB } from '../../lib/corpus.js';

export async function getStaticPaths() {
  return loadHistory().map((fam) => ({ params: { family: fam.slug }, props: { fam } }));
}
const { fam } = Astro.props;
const models = fam.models;

// --- era timeline geometry ------------------------------------------------
// A horizontal Gantt-style era timeline: one row per model, ordered oldest-first
// (top to bottom), each a bar spanning years.start–years.end on a shared year axis.
// A faint left spine draws the succession — the line from one revision to the next —
// since the rows are already in chronological order.
//
// Three bar states, because the page has three facts to keep apart and only ever
// drew two: a verified circuit (solid amber, check mark), a documented circuit
// published as a draft (amber outline, "draft"), and a history-tier model whose
// circuit is not drawn at all (faint dashed outline). Verification is read from the
// circuit's own metadata by loadHistory(); this template never derives it.
const yrs = models.flatMap((m) => [m.years?.start, m.years?.end]).filter((y) => y != null);
const YMIN = Math.min(...yrs) - 1, YMAX = Math.max(...yrs) + 1;
// The right pad holds the wattage and, on a draft row, the word after it.
const W = 1000, PAD_L = 168, PAD_R = 120, PAD_T = 30;
const X0 = PAD_L, X1 = W - PAD_R, PLOTW = X1 - X0;
const ROWH = 34, BARH = 16;
const xScale = (yr) => X0 + ((yr - YMIN) / (YMAX - YMIN)) * PLOTW;
const rows = models.map((m, i) => {
  const s = m.years.start, e = m.years.end;
  const x1 = xScale(s), x2 = Math.max(xScale(e), x1 + 4);
  const cy = PAD_T + i * ROWH + ROWH / 2;
  return { m, i, x1, x2, cy, start: s, end: e };
});
const AXIS_Y = PAD_T + models.length * ROWH + 6;
const H = AXIS_Y + 34;
const ticks = [];
for (let y = Math.ceil(YMIN / 5) * 5; y <= YMAX; y += 5) ticks.push(y);

// The row's own fragment id and its contribution routes, both built once so the
// timeline, the table and the anchors below cannot drift apart.
const ROW_STATE = {
  verified: { label: 'verified', row: 'ver', badge: 'ok' },
  draft: { label: 'draft', row: 'drf', badge: 'draft' },
  history: { label: 'history entry', row: 'hist', badge: 'hist' },
};
const pageUrl = new URL(`history/${fam.slug}/`, Astro.site).href;

// SEO
const nDoc = fam.documentedCount, nVer = fam.verifiedCount, nHist = models.length - nDoc;
const title = `${fam.title} — history & era timeline · Circuit Codex`;
const description =
  `The ${fam.title.replace(/^The /, '')} model by model, ${fam.eraStart}–${fam.eraEnd}: ` +
  `every revision dated, its tube complement and defining change sourced — ${nDoc} with a ` +
  `documented circuit, ${nHist} history-tier. ${fam.maker_style} guitar amplifier lineage.`;
const canonical = new URL(`history/${fam.slug}/`, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${fam.title}: the model line and era timeline`,
  name: title,
  description,
  url: canonical,
  inLanguage: 'en',
  about: `${fam.maker_style} guitar amplifier line history`,
  publisher: { '@type': 'Organization', name: 'Circuit Codex' },
};
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'History', url: '/history/' },
  { name: fam.title, url: `/history/${fam.slug}/` },
];
---
<Base title={title} description={description} ogType="article" jsonld={jsonld} breadcrumbs={breadcrumbs}>
<div class="wrap wrap-wide">
  <header class="page-head">
    <div class="eyebrow"><a href="/history/">History</a> · {fam.maker_style}</div>
    <h1>{fam.title}</h1>
    <p class="lede">{fam.summary}</p>
    <div class="tallies">
      <span class="chip">{fam.eraStart}–{fam.eraEnd}</span>
      <span class="chip">{models.length} model{models.length === 1 ? '' : 's'}</span>
      <span class="chip v">{nDoc} documented</span>
      {nVer > 0 && <span class="chip ok">{nVer} verified</span>}
      {nHist > 0 && <span class="chip">{nHist} history-tier</span>}
    </div>
  </header>

  <figure class="fig">
    <figcaption class="fig-cap">Era timeline — each bar spans a model's production years;
      the chain from top to bottom is the line's succession.</figcaption>
    <div class="scroll">
      <svg class="tl" viewBox={`0 0 ${W} ${H}`} role="img"
           aria-label={`Era timeline of the ${fam.title}: ${models.length} models from ${fam.eraStart} to ${fam.eraEnd}, oldest at top. ${nVer} link a verified circuit, ${nDoc - nVer} link a circuit published as a draft, ${nHist} are history entries with no drawn circuit.`}>
        <!-- year gridlines + axis -->
        <g class="grid">
          {ticks.map((yr) => (
            <g>
              <line x1={xScale(yr)} y1={PAD_T - 8} x2={xScale(yr)} y2={AXIS_Y} />
              <text class="yr" x={xScale(yr)} y={AXIS_Y + 18}>{yr}</text>
            </g>
          ))}
          <line class="axis" x1={X0} y1={AXIS_Y} x2={X1} y2={AXIS_Y} />
        </g>

        <!-- succession spine: connects each model's start to the next, oldest→newest -->
        {rows.slice(0, -1).map((r, i) => {
          const n = rows[i + 1];
          return <path class="spine" d={`M ${r.x1.toFixed(1)} ${r.cy} L ${r.x1.toFixed(1)} ${(n.cy - ROWH / 2).toFixed(1)} L ${n.x1.toFixed(1)} ${n.cy}`} fill="none" />;
        })}

        <!-- model bars -->
        {rows.map((r) => {
          const m = r.m;
          const href = m.documented ? `/amps/${m.ampId}/` : `/history/${fam.slug}/#${m.anchor}`;
          const w = (r.x2 - r.x1).toFixed(1);
          // The accessible name says which of the three states this row is in.
          // Sighted readers get the check mark or the word "draft" beside the
          // wattage; a screen reader was previously told only the designation.
          const spoken = {
            verified: 'documented circuit, verified',
            draft: 'documented circuit, published as a draft',
            history: 'history entry, circuit not drawn yet',
          }[m.tier];
          return (
            <a class={`row ${ROW_STATE[m.tier].row}`} href={href}
               aria-label={`${m.designation}, ${r.start}–${r.end}, ${m.wattage != null ? `${m.wattage} W` : 'wattage not stated'} — ${spoken}`}>
              <text class="desig" x={X0 - 12} y={r.cy} text-anchor="end" dominant-baseline="middle">{m.shortDesig}</text>
              <rect class="bar" x={r.x1.toFixed(1)} y={(r.cy - BARH / 2).toFixed(1)} width={w} height={BARH} rx="4" />
              <circle class="knot" cx={r.x1.toFixed(1)} cy={r.cy} r="3" />
              <text class="wtt" x={(r.x2 + 8).toFixed(1)} y={r.cy} dominant-baseline="middle">
                {m.wattage != null ? `${m.wattage} W` : '—'}
                {m.verified && <tspan class="tick"> ✓</tspan>}
                {m.tier === 'draft' && <tspan class="drf"> draft</tspan>}
              </text>
            </a>
          );
        })}
      </svg>
    </div>
  </figure>

  <div class="legend">
    <span class="lg"><span class="sw ver"></span>Verified circuit — operating point checked against a published chart</span>
    <span class="lg"><span class="sw drf"></span>Draft circuit — drawn and sourced, verification not complete</span>
    <span class="lg"><span class="sw hist"></span>History entry — placed &amp; sourced, circuit not drawn yet</span>
    <span class="lg"><span class="sw-line"></span>Succession within the line</span>
  </div>

  <section>
    <h2>The models</h2>
    <div class="tbl"><table>
      <thead><tr><th>Designation</th><th>Years</th><th>Watts</th><th>Output stage</th><th>Key change</th><th>Circuit</th></tr></thead>
      <tbody>
        {models.map((m, i) => (
          <tr id={m.anchor}>
            <td class="d">{m.designation}
              {/* The row used to be addressed by its position. Those fragment ids
                  are still linked from the lineage graph and from anywhere a reader
                  saved one, so they stay as empty targets beside the stable id the
                  row now carries. */}
              <span class="legacy-anchor" id={`m-${i}`}></span></td>
            <td>{m.years.start}–{m.years.end}</td>
            <td>{m.wattage != null ? `${m.wattage} W` : '—'}</td>
            <td style="font-family:var(--body)">{m.output || '—'}</td>
            <td class="kc" style="font-family:var(--body)">{String(m.key_change).trim()}
              {/* A row whose span deliberately differs from the circuit it links says
                  why, right where a reader can see both numbers. pipeline/validate.py
                  requires the note wherever the two tiers disagree, and rejects one
                  left behind after they stop disagreeing. */}
              {m.era_note && <span class="era-note">{String(m.era_note).trim()}</span>}
              {/* The citations behind this row's dates and engineering claims, where
                  the reader meets them. They were in the data all along and reachable
                  only by opening the family file on GitHub and matching YAML rows by
                  hand. Descriptions are the stored ones, printed as written: this page
                  does not rank a source or call one primary. */}
              {m.sources.length > 0 && (
                <details class="srcs">
                  <summary>Sources for {m.designation} <span class="n">({m.sources.length})</span></summary>
                  <ul>{m.sources.map((s) => (
                    <li>{s.desc}{s.url && <> — <a href={s.url} rel="external nofollow">{new URL(s.url).hostname}</a></>}</li>
                  ))}</ul>
                </details>
              )}</td>
            <td class="circ">
              {m.tier === 'verified' &&
                <a class="badge ok" href={`/amps/${m.ampId}/`}>{displayId(m.ampId)} circuit ↗</a>}
              {m.tier === 'draft' &&
                <a class="badge draft-circ" href={`/amps/${m.ampId}/`}>{displayId(m.ampId)} draft ↗</a>}
              {m.tier === 'history' && <>
                <span class="badge hist">history entry</span>
                {/* Two routes, search first: an open request for this model may
                    already exist, and nothing here knows which — so the reader is
                    sent to look before being offered a new one. */}
                <a class="act" href={issueSearchUrl(m.designation)} rel="external nofollow"
                   >Open requests for {m.designation}{' ↗'}</a>
                <a class="act" rel="external nofollow"
                   href={wantedCircuitUrl({ designation: m.designation, pageUrl: `${pageUrl}#${m.anchor}`, sources: m.sources })}
                   >Suggest research for {m.designation}{' ↗'}</a>
              </>}
            </td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p class="footnote">The circuit column says how far this model has been documented, in
      three states. A <span class="badge ok inline">circuit ↗</span> badge links a
      <a href="/about/#verified">verified</a> circuit: redrawn schematic, parts list, and a
      simulated operating point held against the published voltage chart under a
      maintainer's sign-off. A <span class="badge draft-circ inline">draft ↗</span> badge
      links a circuit that is drawn, sourced and published, but has not completed that
      chain — its own page states what is unresolved. A
      <span class="badge hist inline">history entry</span> is placed, dated and sourced here,
      but its circuit isn't drawn at all yet.</p>
  </section>

  {fam.notes && (
    <section class="story">
      <h2>Dating &amp; notes</h2>
      {fam.notes.split(/\n\s*\n/).map((p) => <p>{p.replace(/\s+/g, ' ').trim()}</p>)}
    </section>
  )}

  <section class="src">
    <h2>Sources</h2>
    <p class="footnote">Each model's own citations are listed in its row above, under
      “Sources for …”. The complete data behind this line — every model's fields as
      stored, including those the page doesn't print — is in
      <a href={`${GITHUB}/blob/main/history/families/${fam.slug}.yaml`}>history/families/{fam.slug}.yaml</a>.</p>
  </section>

  <p class="backlinks">
    <a href="/history/">← All family lines</a> · <a href="/lineage/">See the full lineage tree ↗</a>
  </p>
</div>
</Base>

<style>
  .wrap-wide{max-width:1140px}
  .page-head{padding:56px 0 8px}
  .eyebrow{font-family:var(--disp);text-transform:uppercase;letter-spacing:.2em;font-size:12.5px;color:var(--amber)}
  .eyebrow a{color:var(--amber)}
  h1{font-size:clamp(28px,5vw,46px);line-height:1.05;margin:10px 0 14px;letter-spacing:.05em}
  .lede{max-width:76ch;color:var(--muted);font-size:16px;line-height:1.6}
  .tallies{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}

  .fig{margin:28px 0 0}
  .fig-cap{color:var(--faint);font-size:12.5px;margin:0 2px 8px}
  .scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--well);padding:10px 8px 4px}
  .tl{display:block;width:100%;min-width:720px;height:auto}

  .tl .grid line{stroke:var(--line-soft);stroke-width:1}
  .tl .grid line.axis{stroke:var(--line);stroke-width:1.5}
  .tl .yr{fill:var(--faint);font-family:var(--mono);font-size:11px;text-anchor:middle}
  .tl .spine{stroke:var(--line);stroke-width:1.4;stroke-dasharray:2 3;opacity:.7}

  .tl .row{cursor:pointer}
  .tl .desig{fill:var(--ink);font-family:var(--disp);text-transform:uppercase;letter-spacing:.03em;font-size:13px;font-weight:600}
  .tl .wtt{fill:var(--faint);font-family:var(--mono);font-size:10.5px}
  .tl .wtt .tick{fill:var(--ok)}
  .tl .wtt .drf{fill:var(--muted)}
  .tl .knot{fill:var(--muted)}

  /* Three bar states. Fill carries verification, not documentation: only a
     verified circuit gets the solid bar and the check mark. A draft circuit is
     drawn and linkable, so it keeps the amber outline and the amber designation;
     a model with no circuit at all stays faint and dashed. */
  .tl .ver .bar{fill:var(--amber-dim);stroke:var(--amber);stroke-width:1.4}
  .tl .ver .knot{fill:var(--amber)}
  .tl .ver .desig{fill:var(--amber)}
  .tl .drf .bar{fill:none;stroke:var(--amber);stroke-width:1.4}
  .tl .drf .knot{fill:var(--amber)}
  .tl .drf .desig{fill:var(--amber)}
  .tl .hist .bar{fill:none;stroke:var(--faint);stroke-width:1.3;stroke-dasharray:4 3}
  .tl .row:hover .bar{stroke:var(--amber);stroke-width:1.8}
  .tl .row:hover .desig{fill:var(--amber)}

  .legend{display:flex;gap:20px;flex-wrap:wrap;margin:14px 2px 0;color:var(--faint);font-size:12px}
  .legend .lg{display:inline-flex;align-items:center;gap:7px}
  .legend .sw{width:22px;height:12px;border-radius:3px;display:inline-block;flex:none}
  .legend .sw.ver{background:var(--amber-dim);border:1.4px solid var(--amber)}
  .legend .sw.drf{background:transparent;border:1.4px solid var(--amber)}
  .legend .sw.hist{background:transparent;border:1.3px dashed var(--faint)}
  .legend .sw-line{width:22px;height:0;border-top:1.4px dashed var(--line);display:inline-block;flex:none}

  section{margin:40px 0}
  h2{font-size:18px;letter-spacing:.14em;margin:0 0 12px}
  .d{color:var(--amber);white-space:nowrap}
  .kc{color:var(--muted);font-size:13px;line-height:1.5;min-width:320px}
  .era-note{display:block;margin-top:7px;padding-left:9px;border-left:2px solid var(--line);color:var(--faint);font-size:12px;font-style:italic}
  .badge{font-family:var(--disp);text-transform:uppercase;letter-spacing:.08em;font-size:10px;border:1px solid var(--line);border-radius:99px;padding:3px 9px;white-space:nowrap;display:inline-block}
  .badge.ok{color:var(--ok);border-color:var(--ok)}
  /* A draft circuit is a live link in amber — available, and saying so — while a
     history entry is an unlinked grey label, because there is nothing to open. */
  .badge.draft-circ{color:var(--amber);border-color:var(--amber-dim)}
  .badge.hist{color:var(--muted);border-color:var(--line)}
  .badge.inline{padding:1px 7px;font-size:9px}

  /* Contribution routes out of a history-tier row: stacked under the badge so the
     designation stays in the label at any width. */
  .circ{min-width:186px}
  .circ .act{display:block;margin-top:7px;font-family:var(--body);font-size:12px;line-height:1.4;color:var(--muted)}
  .circ .act:hover{color:var(--amber)}

  /* Per-model citations. Closed by default so the table still reads as a table;
     server-rendered, so the links are in the HTML whether or not it is opened. */
  .srcs{margin-top:9px;border-top:1px dashed var(--line);padding-top:7px}
  .srcs summary{cursor:pointer;font-family:var(--disp);text-transform:uppercase;letter-spacing:.08em;font-size:10px;color:var(--amber)}
  .srcs summary::marker{color:var(--faint)}
  .srcs summary .n{font-family:var(--mono);letter-spacing:0;color:var(--faint)}
  .srcs ul{margin:8px 0 2px;padding-left:16px}
  .srcs li{color:var(--faint);font-size:12px;line-height:1.5;margin:0 0 6px}
  .srcs li a{white-space:nowrap}

  /* A zero-size target that keeps the old positional fragment ids working. */
  .legacy-anchor{display:block;width:0;height:0;overflow:hidden}
  .footnote{color:var(--faint);font-size:12.5px;line-height:1.6;margin:12px 0 0;max-width:82ch}
  .story p{color:var(--ink);font-size:14.5px;max-width:80ch;margin:0 0 12px}
  .backlinks{margin:40px 0 0;font-family:var(--disp);text-transform:uppercase;letter-spacing:.1em;font-size:12px}
  @media(max-width:640px){.kc{min-width:200px}}
</style>
