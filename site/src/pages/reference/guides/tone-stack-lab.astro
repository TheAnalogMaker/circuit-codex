  .hit-dot { fill: var(--amber); stroke: #171310; stroke-width: 1.5; pointer-events: none; }
  .capture { fill: transparent; cursor: crosshair; touch-action: pan-y; }

  .readout { min-height: 1.4em; margin: 14px 2px 2px; font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 13px; color: var(--ink); line-height: 1.6; }
  .comparison-readout { margin: 8px 2px 2px; font: 13px var(--mono); font-variant-numeric: tabular-nums; color: #83becf; line-height: 1.6; }
  .hover-readout { margin: 4px 2px 0; font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 12.5px; color: var(--faint); }

  /* ---- prose ---- */
  .era p { color: var(--muted); font-size: 15px; line-height: 1.7; max-width: 76ch; margin: 0 0 14px; }
  .era p:last-child { margin-bottom: 0; }
  .era strong { color: var(--ink); }
  .era em { font-style: italic; color: var(--ink); }
  .era .cite { font-size: 12.5px; color: var(--faint); max-width: 82ch; }
  .m { font-family: var(--mono); color: var(--ink); font-size: 13px; }
  .assume { max-width: 76ch; margin: 0 0 14px; padding-left: 18px; }
  .assume li { color: var(--muted); font-size: 14.5px; line-height: 1.65; margin-bottom: 9px; }
  .assume strong { color: var(--ink); }

  /* ---- preset cards ---- */
  .pcard { border: 1px solid var(--line); border-radius: 9px; padding: 14px 16px 16px; margin-bottom: 16px; background: var(--panel); }
  .pcard-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }
  .pcard-id { font-family: var(--disp); text-transform: uppercase; letter-spacing: .06em; font-size: 20px; color: var(--amber); }
  .pcard-style { color: var(--muted); font-size: 13px; margin-right: auto; }
