---
import Base from '../../../layouts/Base.astro';
import {
  loadCorpus, toneStackPresets, TONE_STACK_KINDS, TONE_STACK_GATED_IDS, TONE_STACK_GATE_ONLY_IDS, displayId,
} from '../../../lib/corpus.js';
import {
  PLOT, plotX, plotY, curvePath, gridFrequencies, dbGridLines, hzLabel,
  sweepFrequencies, summarise, midPositions, maxPositions, labelPlacement,
} from '../../../lib/tonestack.js';

// Every stack the corpus documents completely enough to plot — component values
// read from each circuit's own bom.yaml at build time.
const presets = toneStackPresets();
const opening = presets[0];

// How many documented circuits carry a tone control at all, counted from the
// corpus rather than typed into the prose below — the sentence that names the
// absentees has to add up, and it only adds up if the total is the corpus's own.
// Why each absentee is absent is recorded beside TONE_STACK_SPECS in lib/corpus.js.
const withToneControl = loadCorpus()
  .filter((a) => (a.meta?.topology?.tone_stack ?? 'none') !== 'none');
const absent = withToneControl.filter((a) => !presets.some((p) => p.id === a.id));
// Every absentee is named in prose below, in one of four groups, and the four
// partition `absent` — so the paragraph stays true as the corpus grows instead
// of quietly leaving new circuits out of its own count.
//   topCut  — a network this solver does not carry at all (the Vox Top Cut sits
//             after the phase inverter, bridged across both of its outputs).
//   gated   — drawing read at lug level and held by the same wiring gate as the
//             presets, but not yet built into one (TONE_STACK_GATE_EXTRAS).
//   single  — one-knob tone controls, not modelled as presets yet.
//   other   — multi-knob networks whose own reading or solver is not done.
const inGroup = (a, ids) => ids.includes(a.id);
const topCut = absent.filter((a) => a.meta.topology.tone_stack === 'top-cut');
const gated = absent.filter((a) => !topCut.includes(a) && inGroup(a, TONE_STACK_GATED_IDS));
const singleKnob = absent.filter((a) => a.meta.topology.tone_stack === 'single-knob'
  && !gated.includes(a) && !topCut.includes(a));
const otherNetwork = absent.filter((a) => !topCut.includes(a)
  && !gated.includes(a) && !singleKnob.includes(a));
// The gated group is whatever extras remain without a preset. Split by the
// circuit's own topology so the sentence does not call a three-knob stack a
// two-knob ladder — and so that the circuits which are neither do not get a
// claim about their network borrowed from the bucket next door. The third
// bucket therefore names its members and says only what is true of every gated
// entry: the wiring gate walks a network only under a kind this lab already
// solves, so what those circuits wait on is a preset, never a new model.
const nameList = (list) => list.map((a) => displayId(a.id)).join(', ')
  .replace(/, ([^,]*)$/, ' and $1');
// A fourth bucket for the drawings the gate walks under a wiring this lab has
// no model for at all (TONE_STACK_GATE_ONLY_IDS): a two-knob network that is
// not the ladder — a tapped Treble pot, a Bass divider — must not be described
// as the ladder, and what it waits on is a model, not a preset.
const gatedOnly = gated.filter((a) => inGroup(a, TONE_STACK_GATE_ONLY_IDS));
const gatedLadder = gated.filter((a) => a.meta.topology.tone_stack === 'tb'
  && !gatedOnly.includes(a));
const gatedFmv = gated.filter((a) => ['fmv', 'cathode-follower-fmv']
  .includes(a.meta.topology.tone_stack) && !gatedOnly.includes(a));
const gatedRest = gated.filter((a) => !gatedLadder.includes(a) && !gatedFmv.includes(a)
  && !gatedOnly.includes(a));
const gatedClauses = [
  gatedLadder.length && `${nameList(gatedLadder)} ${gatedLadder.length === 1 ? 'draws' : 'draw'}`
    + ' the same two-knob ladder the blackface presets are solved with',
  gatedFmv.length && `${nameList(gatedFmv)} ${gatedFmv.length === 1 ? 'draws' : 'draw'}`
    + ' the three-knob network the tweed and British presets are solved with',
  gatedRest.length && `${nameList(gatedRest)} ${gatedRest.length === 1 ? 'draws a network' : 'draw networks'}`
    + ' this lab solves for other circuits but has not yet built a preset around',
  gatedOnly.length && `${nameList(gatedOnly)} ${gatedOnly.length === 1 ? 'draws a two-knob network' : 'draw two-knob networks'}`
    + ' the gate reads lug for lug against the factory sheet but this lab has no model for'
    + ' — a Treble pot with a fixed tap, and a Bass control wired as a divider rather than'
    + ' a rheostat in the ladder',
].filter(Boolean);
const gatedSentence = gatedClauses.length < 2 ? gatedClauses[0]
  : `${gatedClauses.slice(0, -1).join(', ')}, and ${gatedClauses[gatedClauses.length - 1]}`;

// The page ships a real curve in the HTML, drawn by the same code the browser
// uses, so the figure is there before (and without) any script.
const freqs = sweepFrequencies();
const openPos = midPositions();
const openRefPos = opening.kind === 'single-knob' ? { tone: 0 } : maxPositions();
const openPath = curvePath(opening, openPos, freqs);
const openRefPath = curvePath(opening, openRefPos, freqs);
const openSummary = summarise(opening, openPos);

const grid = gridFrequencies();
const dbLines = dbGridLines();
const PW = PLOT.w - PLOT.pad.l - PLOT.pad.r;
const PH = PLOT.h - PLOT.pad.t - PLOT.pad.b;

// Direct labels, placed by the shared helper the script also uses, so nothing
// shifts when the page comes alive.
const openLabels = labelPlacement(opening, openPos, openRefPos);

const CONTROL_LABEL = { treble: 'Treble', mid: 'Middle', bass: 'Bass', tone: 'Tone' };

// Human-readable resistance, in the archive's units style.
function ohms(r) {
  if (r >= 1e6) return `${round(r / 1e6)} MΩ`;
  if (r >= 1e3) return `${round(r / 1e3)} kΩ`;
  return `${round(r)} Ω`;
}
function round(x) {
  return Math.abs(x - Math.round(x)) < 0.05 ? String(Math.round(x)) : x.toFixed(1);
}

const threeKnob = presets.filter((p) => p.kind === 'fmv');
const fixedLeg = presets.filter((p) => p.kind === 'tb');
const ladder = presets.filter((p) => p.wiring === 'ladder');
const valueGroups = (list, key) => [...new Set(list.map((p) => p.parts[key]))]
  .sort((a, b) => b - a)
  .map((value) => `${ohms(value)} in ${nameList(list.filter((p) => p.parts[key] === value))}`)
  .join('; ');
const middleValues = valueGroups(threeKnob, 'midPot');
const fixedValues = valueGroups(fixedLeg, 'midFixed');
const middleRange = [...new Set(threeKnob.map((p) => p.parts.midPot))].sort((a, b) => a - b);
const middleRangeText = middleRange.length === 1 ? ohms(middleRange[0])
  : `${ohms(middleRange[0])} to ${ohms(middleRange.at(-1))}`;
const middleLosses = threeKnob.map((p) => -summarise(p, midPositions()).minDb);
const middleLossRange = `${Math.round(Math.min(...middleLosses))} to ${Math.round(Math.max(...middleLosses))}`;

const clientPresets = presets.map((p) => ({
  id: p.id, kind: p.kind, label: p.label, style: p.style, blurb: p.blurb,
  controls: p.controls, parts: p.parts,
}));

// Level shown with a true minus sign, matching the readout the script writes.
const fmtDb = (db) => (db <= PLOT.dbBottom ? 'below −48' : (db < 0 ? '−' : '+') + Math.abs(db).toFixed(1));
const openReadout = `${opening.label} · treble 5.0 · middle 5.0 · bass 5.0 — deepest cut `
  + `${fmtDb(openSummary.minDb)} dB at ${Math.round(openSummary.minHz)} Hz.`
  + ` 100 Hz ${fmtDb(openSummary.at100)} dB · 1 kHz ${fmtDb(openSummary.at1k)} dB`
  + ` · 5 kHz ${fmtDb(openSummary.at5k)} dB.`;

const description = 'An interactive frequency-response lab for the passive tone stacks of the tube-amp era — the three-knob FMV network, the two-knob treble/bass stack, the tweed Super\'s split tone circuit, and the single tweed tone control — plotted live from the analytic transfer function, with presets built from the real component values of the circuits in the archive whose stacks it solves.';
---
<Base title="Tone-stack lab: plot what the knobs do — Circuit Codex"
      description={description}>
<div class="wrap">
  <header class="ghead">
    <a class="back" href="/reference/">← Reference</a>
    <div class="eyebrow">Interactive guide</div>
    <h1>Tone-stack lab</h1>
    <p class="lede">A guitar amp's tone controls are not an equaliser. They are a
      single passive network sitting between two gain stages, throwing away part of
      the signal on the way past — and the three knobs on the front panel are three
      resistances inside one circuit, each of which changes what the other two do.
      Move them here and watch the frequency response change.</p>
  </header>

  <section class="tool" id="lab" aria-labelledby="lab-h">
    <h2 id="lab-h" class="tool-h">Frequency response</h2>

    <label class="mobile-picker" for="ts-preset">
      <span>Selected circuit</span>
      <select id="ts-preset" disabled>
        {presets.map((p) => (
          <option value={p.id} selected={p.id === opening.id}>{p.label} · {TONE_STACK_KINDS[p.kind].label}</option>
        ))}
      </select>
    </label>
    <nav class="presets" aria-label="Tone-stack presets">
      {presets.map((p) => (
        <a class="preset" href={`?preset=${p.id}#lab`} data-preset={p.id}
           aria-current={p.id === opening.id ? 'true' : undefined}>
          <span class="p-id">{p.label}</span>
          <span class="p-kind">{TONE_STACK_KINDS[p.kind].label}</span>
        </a>
      ))}
    </nav>

    <div class="controls" id="ts-controls">
      {['treble', 'mid', 'bass', 'tone'].map((c) => (
        <label class="ctl" data-ctl={c} hidden={!opening.controls.includes(c)}>
          <span class="ctl-name">{CONTROL_LABEL[c]}</span>
          <input type="range" id={`ts-${c}`} min="0" max="10" step="0.1" value="5"
                 aria-label={CONTROL_LABEL[c]} aria-describedby="ts-position-note" disabled />
          <output class="ctl-val" for={`ts-${c}`} id={`ts-${c}-val`}>5.0</output>
        </label>
      ))}
    </div>
    <p class="position-note" id="ts-position-note">Resistance position, not the amp's dial:
      5 means half the resistance track. <a href="/reference/guides/pot-tapers/">About pot taper ↗</a></p>

    <ul class="legend">
      <li><span class="sw live"></span>This setting</li>
      <li><span class="sw ref"></span><span id="ts-ref-name">Every control at 10</span></li>
    </ul>

    <div class="fig">
      <svg class="chart" id="ts-chart" viewBox={`0 0 ${PLOT.w} ${PLOT.h}`}
           role="img" aria-labelledby="ts-chart-title ts-chart-desc">
        <title id="ts-chart-title">Frequency response of the {opening.label} tone stack,
          10 Hz to 100 kHz</title>
        <desc id="ts-chart-desc">A logarithmic frequency axis from 10 Hz to 100 kHz
          against level in decibels. The numbers for the current setting are given in
          the readout under the chart.</desc>

        {grid.minor.map((f) => (
          <line class="grid minor" x1={plotX(f)} x2={plotX(f)} y1={PLOT.pad.t} y2={PLOT.pad.t + PH} />
        ))}
        {grid.major.map((f) => (
          <line class="grid" x1={plotX(f)} x2={plotX(f)} y1={PLOT.pad.t} y2={PLOT.pad.t + PH} />
        ))}
        {dbLines.map((db) => (
          <line class="grid" x1={PLOT.pad.l} x2={PLOT.pad.l + PW} y1={plotY(db)} y2={plotY(db)} />
        ))}
        <line class="axis unity" x1={PLOT.pad.l} x2={PLOT.pad.l + PW} y1={plotY(0)} y2={plotY(0)} />
        <line class="axis" x1={PLOT.pad.l} x2={PLOT.pad.l} y1={PLOT.pad.t} y2={PLOT.pad.t + PH} />
        <line class="axis" x1={PLOT.pad.l} x2={PLOT.pad.l + PW} y1={PLOT.pad.t + PH} y2={PLOT.pad.t + PH} />

        {grid.major.map((f) => (
          <text class="tick" x={plotX(f)} y={PLOT.pad.t + PH + 20} text-anchor="middle">{hzLabel(f)}</text>
        ))}
        {dbLines.map((db) => (
          <text class="tick" x={PLOT.pad.l - 10} y={plotY(db)} text-anchor="end"
                dominant-baseline="central">{db > 0 ? `+${db}` : db}</text>
        ))}
        <text class="axis-label" x={PLOT.pad.l + PW / 2} y={PLOT.h - 8} text-anchor="middle">Frequency, Hz</text>
        <text class="axis-label" x={-(PLOT.pad.t + PH / 2)} y="14" text-anchor="middle"
              transform="rotate(-90)">Level, dB</text>

        <path class="curve ref" id="ts-ref-curve" d={openRefPath} />
        <path class="curve live" id="ts-live-curve" d={openPath} />

        <text class="curve-label ref" id="ts-ref-label" x={openLabels.x} y={openLabels.yRef}
              text-anchor={openLabels.anchor}>Every control at 10</text>
        <text class="curve-label live" id="ts-live-label" x={openLabels.x} y={openLabels.yLive}
              text-anchor={openLabels.anchor}>This setting</text>

        <line id="ts-cross" class="cross is-off" x1="0" x2="0" y1={PLOT.pad.t} y2={PLOT.pad.t + PH} />
        <circle id="ts-dot" class="hit-dot is-off" r="4.5" cx="0" cy="0" />
        <rect id="ts-capture" class="capture" x={PLOT.pad.l} y={PLOT.pad.t} width={PW} height={PH} />
      </svg>
    </div>

    <script type="application/json" id="ts-data" is:inline set:html={JSON.stringify(clientPresets)}></script>

    <p class="readout" id="ts-readout" aria-live="polite">{openReadout}</p>
    <p class="comparison-readout" id="ts-comparison-readout" aria-live="polite" hidden></p>
    <p class="hover-readout" id="ts-hover" aria-hidden="true">Point at the chart to read a frequency.</p>
    <div class="lab-actions">
      <button type="button" id="ts-pin" disabled>Pin comparison</button>
      <button type="button" id="ts-clear" hidden>Clear comparison</button>
      <button type="button" id="ts-reset" disabled>Reset sliders to 5</button>
      <button type="button" id="ts-copy" disabled>Copy this setting</button>
    </div>
    <p class="action-help">Pin a curve, then choose another circuit or move the sliders to compare.
      Reset changes the active sliders; a pinned comparison stays fixed.</p>
    <p class="copy-status" id="ts-copy-status" role="status"></p>
    <label class="copy-fallback" id="ts-copy-fallback" hidden>Copy this link
      <input id="ts-copy-url" type="text" readonly />
    </label>
    <p class="p-blurb" id="ts-blurb">{opening.blurb}</p>
    <noscript><p class="hover-readout">The chart above is the {opening.label} stack with
      every control at 5, against the same stack with everything at 10. Moving the
      controls and restoring a shared setting need JavaScript; the component values behind every preset are tabulated
      further down this page.</p></noscript>
  </section>

  <section aria-labelledby="read-h">
    <h2 id="read-h">Reading the curve</h2>
    <div class="era">
      <p>The vertical axis is level in decibels, referred to the open-circuit signal of
        the stage driving the network — what that stage would deliver into no load at
        all, before its own output resistance is charged for. That is the useful
        reference, because the loss the driving stage's output resistance suffers into
        the stack is part of what the stack costs: on a plate-fed circuit it is more
        than a decibel of the reading, on a follower-fed one a rounding error. Nothing
        here is an amplifier: a passive tone stack has no gain of its own, so every curve
        on this page sits at or below the 0 dB line. What the controls choose is
        <em>which</em> frequencies get thrown away and how much of them — the stage after
        the stack then makes the level back up.</p>
      <p><strong>The scoop is the point.</strong> Set a three-knob preset to five all
        round and the curve sags in the middle, a broad dip several hundred hertz wide
        with the bass climbing away below it and the treble climbing away above. That
        dip is what people mean by a scooped midrange, and it is not a side-effect: it
        is what happens when a bass path and a treble path are recombined with
        nothing filling the gap between them. Pull the Middle control down and the dip
        deepens into a proper notch; push it up and the notch fills, but never quite to
        flat.</p>
      <p><strong>Everything on 10 is not flat.</strong> Turn all three controls fully up
        and the curve does not become a straight line — the dip is still there, only
        shallower, and the whole response stays below 0 dB across the midrange. The
        controls set where the network's three paths hand over to each other; they cannot
        remove the hand-over. That is the dashed reference curve until you pin a
        comparison (the one-knob preset instead uses Tone at 0). The
        stack has a voice of its own that no knob position turns off.</p>
      <p><strong>Insertion loss is real, and it is large.</strong> Look at where the
        deepest cut sits across the {threeKnob.length} three-knob presets — about
        {middleLossRange} decibels down with every control at five. The circuit pays for the tone
        controls in level. The tweed Bassman and British presets use a
        <a href="/topology/tone-stack-cf-fmv/">cathode follower</a> to drive the stack;
        the Twin and Super Reverb presets are plate-fed. A designer who wanted a milder tone control could have one;
        what these amps wanted was <em>range</em>, and range costs signal.</p>
      <p><strong>The controls interact — and the wiring sets what happens at the
        stops.</strong> In the {threeKnob.length} three-knob presets, the middle
        pot's full track always stands between the network's foot and ground.
        Bass and Middle at zero do not remove that resistance. Its value varies:
        {middleValues}. The textbook
        redrawing of the same parts — output node joined to both wipers, rheostat mid
        leg — would instead tie the output to ground through the remains of the
        network and go nearly silent; the solver also holds that form, but these
        {threeKnob.length} presets use the ladder wiring.</p>
    </div>
  </section>

  <section aria-labelledby="how-h">
    <h2 id="how-h">How the network does it</h2>
    <div class="era">
      <p>Ignore the knobs for a moment and follow the signal. It arrives at one node and
        leaves from another, and between them it can take three routes to the output.</p>
      <p><strong>The treble route</strong> starts at a very small capacitor — each
        preset's value appears in its parts table below. A capacitor that small is close to
        an open circuit at bass frequencies and close to a wire at treble, so this path
        carries only the top end. It lands on the treble pot; the wiper decides how much
        of that top end reaches the output and how much is bled away into the rest of the
        network.</p>
      <p><strong>The bass and mid routes</strong> both start behind the slope resistor —
        the resistor between the input and the network's lower half, 33 kΩ to 100 kΩ
        depending on the circuit. From there two much larger capacitors, in the tens of
        nanofarads, feed the bass pot and the mid leg. Large capacitors pass low
        frequencies happily, so this half of the network carries the body of the sound.
        The slope resistor's job is to hold this whole lower half back relative to the
        treble route: it sets the tilt of the curve, which is why changing it, as Marshall
        did in going from 56 kΩ to 33 kΩ, changes the amp's whole character without moving
        a single knob.</p>
      <p><strong>The output is the treble pot's wiper, alone.</strong> That is the
        <em>ladder</em> wiring used by the {ladder.length} three-knob and blackface
        two-knob presets: the bass pot is a rheostat in
        series down the network's lower half, and the Bass control works by varying how
        hard that lower half loads the treble pot. The <em>joined</em> wiring — the
        textbook redrawing of the same parts, with the treble and bass wipers meeting
        at a single output node — is kept in the solver as a reference form.
        Either way
        the controls cannot be separated; the wirings differ in <em>where</em> the
        collision happens, and, as the sections below show, in what happens at the
        stops.</p>
      <p><strong>The mid leg is the network's foot.</strong> Below the bass pot the
        network runs to ground through whatever the circuit puts there. A three-knob stack
        puts a small pot there — {middleRangeText} in these presets — and that pot is
        the Middle control: the pot's full track always stands in the leg, the mid
        capacitor lands on its <em>wiper</em>, and the control slides the capacitor's
        injection point along a fixed resistance. Fender's two-knob blackface circuits
        replace the pot with a fixed resistor — {fixedValues} — but keep the capacitor that feeds
        the leg. The tweed Super's two knobs are no member of this family at all: its
        sheet draws a different network — treble and bass on two separate branches,
        recombined at the output — and its preset below is solved as that network. One
        solver holds all of these forms; each preset is solved with the wiring its own
        circuit's schematic draws.</p>
    </div>
  </section>

  <section aria-labelledby="two-h">
    <h2 id="two-h">Two knobs against three</h2>
    <div class="era">
      <p>Switch between the presets and the difference in the curve is larger than one
        missing control, and it is not the missing control that does it. What carves the
        notch is the second low-end path: a capacitor on the mid leg as well as on the
        bass leg, two routes down from the slope resistor arriving at the output node from
        different places. The {threeKnob.length} three-knob presets have it, and so do the {fixedLeg.length} blackface
        two-knob presets — which is why a blackface amp is scooped with both knobs at five
        even though it has no Middle control to blame. The tweed Super's preset is the
        odd one out because its circuit is: with treble and bass on separate branches
        and no shared cap ladder, five-and-five leaves only a shallow saddle — about
        7 dB at its deepest, near 190 Hz — though pushing both controls to ten deepens
        the crossover valley between the two branches to around 18 dB at 1 kHz.</p>
      <p>The foot of the network is worth trying at the extremes, because the families
        end differently. On 5F6-A, with Treble at five and Bass and Middle both at
        zero, the lowest point is around 31 dB down: its middle track remains in the
        ground leg. AB763 Deluxe Reverb with Treble at five and Bass at zero reaches
        around 29 dB down. Other presets have different component values and source
        resistances, so their floors differ; pin one to compare them. The
        split-network 5F4 behaves differently again — Bass at zero grounds its bass
        branch's injection point, and the low end falls some fifty decibels while the
        treble branch keeps playing, only about 13 dB down at 5 kHz: one branch can go
        quiet while the other carries on. The resistance that sets a circuit's floor is
        also the reason it never goes entirely quiet.</p>
      <p>The Middle control's authority is worth a moment too. On the 5F6 preset with
        Treble and Bass at five, moving Middle from 0 to 10 lifts the bottom of the notch
        from about 23 dB down to about 10 dB down and walks it from roughly 860 Hz to
        640 Hz. It is a real control — but it fills the dip rather than removing it, which
        is why a three-knob amp still sounds like a three-knob amp with the Middle
        buried.</p>
    </div>
  </section>

  <section aria-labelledby="math-h">
    <h2 id="math-h">Where the curve comes from</h2>
    <div class="era">
      <p>The curve is not sampled from a table or traced from a published plot. At each
        of {freqs.length} frequencies across the sweep the network is solved from scratch
        by nodal analysis: one Kirchhoff current-law equation per node, capacitors entered
        as an admittance of <span class="m">jωC</span> and resistors as
        <span class="m">1/R</span>, the driving stage entered as an ideal source behind
        its own output resistance, and the resulting complex system solved for the voltage
        at the output node. The wiper positions enter as two resistances per pot — the
        track above the wiper and the track below it — which is why a control at either
        stop behaves so differently from the same control near the middle.</p>
      <p>Five assumptions are worth naming, because they are the difference between this
        curve and a measurement at the back of a real amplifier:</p>
      <ul class="assume">
        <li><strong>The driving stage is a resistance.</strong> A cathode follower is
          entered at roughly 1/g<sub>m</sub> of the driving triode; a plate is entered at
          its plate resistance in parallel with its plate-load resistor. Both figures come
          from the driving tube's published small-signal data and the circuit's own parts
          list — for a 12AX7 that is about 625 Ω from a follower and 38 kΩ from a plate.
          The difference matters: a stack fed from a plate is loaded by its own source in
          a way a follower-fed stack is not.</li>
        <li><strong>The output is loaded by one resistor</strong> — the grid leak or
          volume pot the stack actually drives, again read from the parts list. The
          following stage's input capacitance, and the Miller capacitance of the tube
          behind it, are not modelled; both push the very top of the treble down a little
          further than the plot shows.</li>
        <li><strong>The slider is track, not dial.</strong> A control at 5 here means half
          of the pot's resistance is in circuit. On a real amp with an audio-taper pot,
          half the track arrives at around 7 on the printed dial — see the guide to
          <a href="/reference/guides/pot-tapers/">potentiometer taper</a>, which classifies
          every pot in the corpus from its own parts list.</li>
        <li><strong>The parts are their marked values.</strong> Carbon-composition
          resistors of the era were ±10% or ±20% parts, and the paper and mica capacitors
          were no better; two amps off the same production line did not share this curve
          exactly. Read the shape, not the third decimal place.</li>
        <li><strong>This is the network alone.</strong> The speaker, the output
          transformer, and every coupling capacitor elsewhere in the amp shape the sound
          at least as much as the tone stack does, and none of them is in this plot.</li>
      </ul>
      <p class="cite">The solver behind the page was checked against independent
        ngspice AC sweeps of the same element lists — the joined reference form, the
        ladder network in both its mid-leg forms (the three-knob 5F6 and 5F6-A, the
        fixed-leg AA964 and AB763), and the 5F4's split network, using the same
        simulator the archive uses to verify every operating point — and agrees with
        each to within 5 × 10⁻⁵ dB across the sweep. For what a decibel is, see
        <a href="/reference/guides/units-conventions/">units and notation</a>.</p>
    </div>
  </section>

  <section aria-labelledby="corpus-h">
    <h2 id="corpus-h">The stacks the lab can plot</h2>
    <p class="sub">Each preset is built at deploy time from its circuit's own parts list —
      the values below are the ones the plot uses, read straight from the archive. Load
      one into the lab and the address bar keeps it, so a setting can be linked to
      directly.</p>
    <p class="sub">{withToneControl.length} circuits in the archive carry a tone control and
      {' '}{presets.length} of them are presets here.{absent.length === 0 ? '' : ' '}
      {absent.length > 0 && (<>Of the {absent.length} that are absent,
      {topCut.length > 0 && (<>
        {/* A bare space between two adjacent expressions is dropped by the compiler,
            which is how "AC15 and AC30are the ones" shipped — spaces that matter are
            written {' '}. */}
        {' '}{nameList(topCut)}{' '}{topCut.length === 1 ? 'is the one' : 'are the ones'} whose
        network the solver genuinely lacks: the Vox Top Cut sits after the phase inverter,
        bridged across both of its outputs — a differential cut with no counterpart in these
        stacks.
      </>)}
      {gated.length > 0 && (<>
        {' '}{gatedSentence}. {gated.length === 1 ? 'It is' : 'All are'} read at lug level and held by the same
        wiring gate as the presets here, but not yet built into
        {' '}{gated.length === 1 ? 'a preset' : 'presets'}
        {gatedOnly.length === 0 ? (<> — {gated.length === 1 ? 'it waits' : 'they wait'}
        {' '}on that step rather than on a new model.</>) : (<> — {gatedOnly.length === gated.length
          ? (gated.length === 1 ? 'it waits' : 'they wait')
          : `all but ${nameList(gatedOnly)} wait`}
        {' '}on that step rather than on a new model{gatedOnly.length === gated.length ? '' : `; ${nameList(gatedOnly)}
        ${gatedOnly.length === 1 ? 'waits' : 'wait'} on the model`}.</>)}
      </>)}
      {singleKnob.length > 0 && (<>
        {' '}The single tone controls of {nameList(singleKnob)} are simply not built as presets yet.
      </>)}
      {otherNetwork.length > 0 && (<>
        {' '}And the multi-knob networks of {nameList(otherNetwork)} wait on the closer reading
        their own drawings still owe.
      </>)}
      {' '}A curve for a network that is not the circuit's own would not be
      recoverable, so each of these waits until its own is drawn.</>)}</p>

    {presets.map((p) => (
      <div class="pcard">
        <div class="pcard-head">
          <a class="pcard-id" href={`?preset=${p.id}#lab`} data-preset={p.id}>{p.label}</a>
          <span class="pcard-style">{p.style} · {p.era.start}–{p.era.end}</span>
          <span class="chip">{TONE_STACK_KINDS[p.kind].label}</span>
          {p.topologyHref && <a class="chip" href={p.topologyHref}>topology ↗</a>}
          <a class="chip" href={`/amps/${p.id}/`}>circuit ↗</a>
        </div>
        <p class="pcard-blurb">{p.blurb}</p>
        <div class="tbl"><table>
          <thead><tr><th>Ref</th><th>Part</th><th>Value</th><th>Position in the network</th></tr></thead>
          <tbody>
            {p.bill.map((b) => (
              <tr>
                <td style="color:var(--amber)">{b.ref}</td>
                <td style="font-family:var(--body)">{b.part}</td>
                <td>{b.value}</td>
                <td style="font-family:var(--body);color:var(--faint)">{b.role}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
        <p class="pcard-foot">
          Driven from {p.drive.kind === 'cathode-follower' ? 'a cathode follower' : 'a plate'},
          entered at {ohms(p.drive.ohms)};
          {p.loadRef ? ` loaded by ${ohms(p.loadOhms)} (${p.loadRef}).` : ' solved unloaded — the output drives the next grid directly.'}
          {p.midLeg === 'ground' && ' The mid leg runs straight to ground.'}
          {p.midLeg === 'fixed' && ' The mid leg is a fixed resistor rather than a control.'}
          {p.note && ` ${p.note}`}
          {p.omits.length > 0 && ` Not modelled: ${p.omits.map((o) => `${o.ref} (${o.value}, ${o.role})`).join('; ')}.`}
        </p>
      </div>
    ))}
  </section>

  <section aria-labelledby="one-h">
    <h2 id="one-h">The one-knob tweed tone control</h2>
    <div class="era">
      <p>The small tweed amps carry a single Tone knob, and it is not a cut-down version
        of the stacks above — it is a different circuit doing a different job. The pot is
        wired as a rheostat, two terminals instead of three, in series with one small
        capacitor from the signal line straight to ground. That branch is a variable
        drain: at one end of the shaft the capacitor is bled to ground through the whole
        million ohms of the track and almost nothing escapes; at the other the capacitor
        sits directly across the signal and takes the treble with it.</p>
      <p>Load the {displayId('5f2a')} preset and sweep the knob, and the network's real
        character shows up immediately: almost the entire audible change is crowded into
        the bottom of the travel. Above about 2 on the slider the bleed branch is a much
        higher impedance than the stage driving it, so it does essentially nothing; below
        that it takes over quickly. This is a genuine property of a 1 MΩ pot working
        against a 0.005 µF capacitor and a plate of a few tens of kilohms, not a quirk of
        the plot — and it is why a tweed tone control is so often described as doing
        nothing until it is nearly off.</p>
      <p>It is also why the driving impedance is not a detail here. The Bassman's stack
        is fed from a follower stiff enough that the network barely loads it; this one is
        fed from a plate, and the bleed works <em>against</em> that plate resistance. Take
        the source impedance away and the control would do nothing at all.</p>
      <p>Where each circuit sits on that ladder — no tone control, one knob, two, three —
        is gathered on the <a href="/topology/">topology pages</a>.</p>
    </div>
  </section>
</div>
</Base>

<script>
  import {
    PLOT, plotY, plotF, sweepFrequencies, summarise, responseDb,
    labelPlacement,
  } from '../../../lib/tonestack.js';
  import {
    CONTROLS, readLabState, writeLabState, selectLabPreset, pinLabComparison,
    referenceSetting, labCurvePaths,
  } from '../../../lib/tonestack-state.js';

  const el = (id) => document.getElementById(id);
  const dataNode = el('ts-data');
  if (dataNode) {
    const PRESETS = JSON.parse(dataNode.textContent);
    const byId = new Map(PRESETS.map((p) => [p.id, p]));
    const CONTROL_LABEL = { treble: 'Treble', mid: 'Middle', bass: 'Bass', tone: 'Tone' };
    const FREQS = sweepFrequencies();

    const chart = el('ts-chart');
    const liveCurve = el('ts-live-curve');
    const refCurve = el('ts-ref-curve');
    const liveLabel = el('ts-live-label');
    const refLabel = el('ts-ref-label');
    const refName = el('ts-ref-name');
    const picker = el('ts-preset');
    const readout = el('ts-readout');
    const comparisonReadout = el('ts-comparison-readout');
    const hover = el('ts-hover');
    const blurb = el('ts-blurb');
    const title = el('ts-chart-title');
    const cross = el('ts-cross');
    const dot = el('ts-dot');
    const capture = el('ts-capture');
    const pin = el('ts-pin');
    const clear = el('ts-clear');
    const reset = el('ts-reset');
    const copy = el('ts-copy');
    const copyStatus = el('ts-copy-status');
    const copyFallback = el('ts-copy-fallback');
    const copyUrl = el('ts-copy-url');

    let state = readLabState(location.search, PRESETS);
    picker.disabled = false;
    for (const button of [pin, reset, copy]) button.disabled = false;
    el('lab').classList.add('is-interactive');

    const sliders = {};
    for (const c of CONTROLS) {
      const input = el('ts-' + c);
      if (!input) continue;
      sliders[c] = { input, out: el('ts-' + c + '-val'), row: input.closest('.ctl') };
      input.addEventListener('input', () => {
        state.pos[c] = Number(input.value) / 10;
        render();
      });
    }

    const refTitle = () => state.comparison ? 'Pinned: ' + state.comparison.preset.label
      : state.preset.kind === 'single-knob' ? 'Tone at 0' : 'Every control at 10';
    const settingText = (setting) => setting.preset.controls
      .map((c) => CONTROL_LABEL[c].toLowerCase() + ' ' + (setting.pos[c] * 10).toFixed(1))
      .join(' · ');

    function fmt(db) {
      return db <= -48 ? 'below −48' : (db < 0 ? '−' : '+') + Math.abs(db).toFixed(1);
    }

    function render() {
      const { preset, pos, comparison } = state;
      const reference = referenceSetting(state);
      const paths = labCurvePaths(state, FREQS);
      liveCurve.setAttribute('d', paths.live);
      refCurve.setAttribute('d', paths.reference);
      refCurve.classList.toggle('pinned', Boolean(comparison));
      el('lab').classList.toggle('has-comparison', Boolean(comparison));

      // The solver's direct-label helper assumes one preset. Cross-preset
      // overlays use the legend and full readouts instead of misplacing labels.
      for (const node of [liveLabel, refLabel]) node.classList.toggle('is-off', Boolean(comparison));
      if (!comparison) {
        const lab = labelPlacement(preset, pos, reference.pos);
        for (const [node, y] of [[liveLabel, lab.yLive], [refLabel, lab.yRef]]) {
          node.setAttribute('x', lab.x.toFixed(1));
          node.setAttribute('y', y.toFixed(1));
          node.setAttribute('text-anchor', lab.anchor);
        }
      }
      refLabel.textContent = refTitle();
      refName.textContent = refTitle();

      for (const c of Object.keys(sliders)) {
        const on = preset.controls.includes(c);
        sliders[c].row.hidden = !on;
        sliders[c].input.disabled = !on;
        sliders[c].input.value = (pos[c] * 10).toFixed(1);
        sliders[c].out.textContent = (pos[c] * 10).toFixed(1);
      }

      const s = summarise(preset, pos);
      const deepest = s.interior
        ? 'deepest cut ' + fmt(s.minDb) + ' dB at ' + Math.round(s.minHz) + ' Hz.'
        : 'lowest point ' + fmt(s.minDb) + ' dB, at the '
          + (s.minHz > 1000 ? 'top' : 'bottom') + ' of the sweep — no dip in between.';
      readout.textContent = preset.label + ' · ' + settingText(state) + ' — ' + deepest
        + ' 100 Hz ' + fmt(s.at100) + ' dB · 1 kHz ' + fmt(s.at1k)
        + ' dB · 5 kHz ' + fmt(s.at5k) + ' dB.';
      blurb.textContent = preset.blurb || blurb.textContent;
      title.textContent = 'Frequency response of the ' + preset.label
        + ' tone stack' + (comparison ? ' compared with ' + comparison.preset.label : '')
        + ', 10 Hz to 100 kHz';
      el('ts-chart-desc').textContent = 'A logarithmic frequency axis from 10 Hz to 100 kHz'
        + ' against level in decibels. Solid amber: this setting. Dashed '
        + (comparison ? 'blue: ' : 'grey: ') + refTitle()
        + '. Settings and levels are given in the readouts below the chart.';
      comparisonReadout.hidden = !comparison;
      if (comparison) {
        const cs = summarise(comparison.preset, comparison.pos);
        comparisonReadout.textContent = refTitle() + ' · ' + settingText(comparison)
          + ' — 100 Hz ' + fmt(cs.at100) + ' dB · 1 kHz ' + fmt(cs.at1k)
          + ' dB · 5 kHz ' + fmt(cs.at5k) + ' dB.'
          + (paths.live === paths.reference ? ' The curves overlap.' : '');
      }
      clear.hidden = !comparison;
      pin.textContent = comparison ? 'Replace pinned comparison' : 'Pin comparison';
      picker.value = preset.id;

      for (const a of document.querySelectorAll('.preset')) {
        if (a.dataset.preset === preset.id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
      cross.classList.add('is-off');
      dot.classList.add('is-off');
      hover.textContent = 'Point at the chart to read a frequency.';
      copyStatus.textContent = '';
      copyFallback.hidden = true;
      const url = new URL(location.href);
      url.search = writeLabState(state, url.search).toString();
      history.replaceState(null, '', url);
    }

    function selectPreset(id) {
      const next = byId.get(id);
      if (!next) return;
      state = selectLabPreset(state, next);
      render();
    }
    picker.addEventListener('change', () => selectPreset(picker.value));
    for (const a of document.querySelectorAll('[data-preset]')) {
      a.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        selectPreset(a.dataset.preset);
        if (a.classList.contains('pcard-id')) el('lab').scrollIntoView();
      });
    }
    pin.addEventListener('click', () => { state = pinLabComparison(state); render(); });
    clear.addEventListener('click', () => {
      state.comparison = null;
      render();
      pin.focus();
    });
    reset.addEventListener('click', () => { state = selectLabPreset(state, state.preset); render(); });
    window.addEventListener('popstate', () => { state = readLabState(location.search, PRESETS); render(); });
    copy.addEventListener('click', async () => {
      const url = new URL(location.href);
      url.hash = 'lab';
      try {
        await navigator.clipboard.writeText(url.href);
        copyStatus.textContent = state.comparison ? 'Setting and comparison copied.' : 'Setting copied.';
      } catch {
        copyStatus.textContent = 'Select and copy the link below.';
        copyFallback.hidden = false;
        copyUrl.value = url.href;
        copyUrl.focus();
        copyUrl.select();
      }
    });

    // Pointer read-off across the plot.
    function readAt(clientX) {
      const rect = chart.getBoundingClientRect();
      const x = PLOT.pad.l + Math.min(
        PLOT.w - PLOT.pad.l - PLOT.pad.r,
        Math.max(0, ((clientX - rect.left) * (PLOT.w / rect.width)) - PLOT.pad.l),
      );
      const f = plotF(x);
      const db = responseDb(state.preset, state.pos, f);
      cross.setAttribute('x1', x.toFixed(1));
      cross.setAttribute('x2', x.toFixed(1));
      dot.setAttribute('cx', x.toFixed(1));
      dot.setAttribute('cy', plotY(db).toFixed(1));
      cross.classList.remove('is-off');
      dot.classList.remove('is-off');
      const hz = f >= 1000 ? (f / 1000).toFixed(2) + ' kHz' : Math.round(f) + ' Hz';
      const reference = referenceSetting(state);
      hover.textContent = 'At ' + hz + ': this setting ' + fmt(db) + ' dB; '
        + refTitle() + ' ' + fmt(responseDb(reference.preset, reference.pos, f)) + ' dB.';
    }
    capture.addEventListener('pointermove', (e) => readAt(e.clientX));
    capture.addEventListener('pointerdown', (e) => readAt(e.clientX));
    capture.addEventListener('pointerleave', () => {
      cross.classList.add('is-off');
      dot.classList.add('is-off');
      hover.textContent = 'Point at the chart to read a frequency.';
    });

    render();
  }
</script>

<style>
