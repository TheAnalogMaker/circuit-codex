  .preset[aria-current] .p-id { color: var(--amber); }
  .preset .p-kind { font-size: 10.5px; color: var(--faint); letter-spacing: .04em; }

  .p-blurb { color: var(--muted); font-size: 13.5px; margin: 0 0 14px; max-width: 72ch; line-height: 1.55; }
