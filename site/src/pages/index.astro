---
import Base from '../layouts/Base.astro';
import { corpusByFamily, corpusStats, displayId, datasetJsonLd, GITHUB } from '../lib/corpus.js';
// The corpus grid is grouped by amp line — the family that documents each circuit
// in the history tier, oldest cosmetic era first. Grouping and order both come from
// the data (see corpusByFamily), so a new circuit files itself under the right
// heading and a new family line adds its own section.
const families = corpusByFamily();
const stats = corpusStats();

// Section subtitle: the era style(s) the group's circuits record, the years they span,
// and how many are documented — omitting any part the data doesn't carry.
const famMeta = (f) => [
  f.styles.filter((s) => s !== f.title).join(' · ') || null,
  f.eraStart != null ? `${f.eraStart}–${f.eraEnd}` : null,
  `${f.amps.length} circuit${f.amps.length === 1 ? '' : 's'}`,
].filter(Boolean).join(' · ');

// Structured data. The corpus itself is one schema.org Dataset (data catalogues and
// Google Dataset Search read this); the circuit grid below is the matching ItemList,
// in the order the page actually renders it.
const dataset = datasetJsonLd(Astro.site);
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Documented circuits in the Circuit Codex corpus',
  description: 'Every tube-amplifier circuit documented in the archive, grouped by amp line, oldest era first.',
  numberOfItems: stats.circuits,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: families.flatMap((f) => f.amps).map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${displayId(a.id)} — ${a.meta.name_style}`,
    url: new URL(`amps/${a.id}/`, Astro.site).href,
  })),
};
---
<Base title="Circuit Codex — the open archive of classic guitar amp circuits"
      description="Every classic tube amp circuit — redrawn KiCad schematics, ngspice-verified netlists, and the lineage that connects them. Open, machine-readable, CC-BY-SA."
      jsonld={[dataset, itemList]}>
<div class="wrap">
  <header class="hero">
    <div class="eyebrow">An open, machine-readable archive</div>
    <h1>Every classic tube amp circuit.<br />Redrawn. Verified. Connected.</h1>
    <p class="lede">The amplifiers that made electric guitar — as clean KiCad schematics,
      <strong>simulation-checked netlists</strong>, and structured metadata, built in the open.
      No scans: every circuit is redrawn from the underlying facts. A
      <a href="/about/#verified">verified</a> badge means the netlist landed inside
      the published voltage chart in CI; drafts are published with the blocker named.
      Free forever, CC-BY-SA.
      New here? <a href="/about/">Start with what this is, what it proves, and how to
      contribute</a>.</p>
    <div class="stats" role="list">
      <div class="stat" role="listitem"><div class="n">{stats.circuits}</div><div class="l">circuit{stats.circuits === 1 ? '' : 's'}</div></div>
      <div class="stat" role="listitem"><div class="n">{stats.verified}</div><div class="l">verified</div></div>
      <div class="stat" role="listitem"><div class="n">{stats.models}</div><div class="l">CC0 tube SPICE models</div></div>
      <div class="stat" role="listitem"><div class="n">{stats.historyModels}</div><div class="l">model histories</div></div>
    </div>
  </header>

  <section class="explore" aria-labelledby="explore-h">
    <h2 id="explore-h">Start here</h2>
    <p class="sub">The archive is more than a circuit index. These are the surfaces
      that show how the circuits connect, and what the knobs actually do.</p>
    <div class="grid explore-grid">
      <a class="card" href="/reference/guides/tone-stack-lab/">
        <div class="id">Tone-stack lab</div>
        <div class="style">Move the knobs. The curve is the circuit's own parts.</div>
        <div class="tubes">The factory sheets draw a ladder, not the textbook stack — <span class="inline-link">study ↗</span></div>
      </a>
      <a class="card" href="/reference/guides/load-lines/">
        <div class="id">Load-line explorer</div>
        <div class="style">Plate curves from the corpus CC0 models, in the browser.</div>
        <div class="tubes">Start from any documented output stage</div>
      </a>
      <a class="card" href="/lineage/">
        <div class="id">Lineage tree</div>
        <div class="style">Succession inside each family; arrows only where a derivation is documented.</div>
        <div class="tubes">{stats.historyModels} models across {stats.families} lines</div>
      </a>
      <a class="card" href="/reference/studies/tone-stack-ladder/">
        <div class="id">The ladder finding</div>
        <div class="style">What the published sheets actually draw at the lugs.</div>
        <div class="tubes">A cited study, not a slogan</div>
      </a>
    </div>
  </section>

  <section id="circuits">
    <h2>The corpus</h2>
    <p class="sub">Every documented circuit, grouped by the line it belongs to, oldest era first.
      <a href="/history/">The history tier</a> places each line's other models;
      <a href={`${GITHUB}/blob/main/CONTRIBUTING.md`}>contributions welcome</a>.</p>
    {families.map((f) => (
      <div class="fam">
        <div class="fam-head">
          <h3>{f.href ? <a href={f.href}>{f.title}</a> : f.title}</h3>
          <div class="fam-meta">{famMeta(f)}</div>
        </div>
        <div class="grid">
          {f.amps.map((a) => (
            <a class="card" href={`/amps/${a.id}/`}>
              <div class="id">{displayId(a.id)}</div>
              <div class="style">{a.meta.name_style} · {a.meta.wattage} W</div>
              <div class="tubes">{a.meta.tubes.join(' · ')}</div>
              <div class="chips">
                <span class="chip">{a.meta.era.start}–{a.meta.era.end}</span>
                <span class="chip">{a.meta.topology.phase_inverter === 'none' ? 'single-ended' : a.meta.topology.phase_inverter}</span>
                {a.meta.verification?.status === 'verified'
                  ? <span class="chip v">verified</span>
                  : <span class="chip">draft</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</div>
</Base>

<style>
  .hero{padding:72px 0 40px}
  .eyebrow{font-family:var(--disp);text-transform:uppercase;letter-spacing:.26em;font-size:12.5px;color:var(--amber)}
  h1{font-size:clamp(32px,5.5vw,54px);line-height:1.08;margin:14px 0 18px}
  .lede{max-width:60ch;color:var(--muted);font-size:17px}
  .lede strong{color:var(--ink)}
  .stats{display:flex;margin:36px 0 8px;border:1px solid var(--line);border-radius:6px;background:var(--panel);overflow-x:auto;width:fit-content}
  .stat{padding:16px 26px;border-right:1px solid var(--line-soft);min-width:110px}
  .stat:last-child{border-right:0}
  .stat .n{font-family:var(--disp);font-size:30px;color:var(--amber);font-variant-numeric:tabular-nums}
  .stat .l{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--faint)}
  h2{font-size:20px;letter-spacing:.14em;margin:24px 0 4px}
  .sub{color:var(--muted);font-size:14.5px;margin:0 0 22px}
  /* --- family sections (grouped corpus grid) --- */
  .fam{margin:0 0 22px}
  .fam-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;
    margin:0 0 10px;padding-bottom:6px;border-bottom:1px solid var(--line-soft)}
  .fam-head h3{font-size:15px;letter-spacing:.16em;margin:0;color:var(--ink)}
  .fam-head h3 a{color:inherit}
  .fam-head h3 a:hover{color:var(--amber)}
  .fam-meta{font-family:var(--mono);font-size:11.5px;color:var(--faint)}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px 18px 14px;display:flex;flex-direction:column;gap:8px;color:inherit}
  .card:hover{border-color:var(--amber-dim);text-decoration:none}
  .card .id{font-family:var(--disp);font-size:24px;letter-spacing:.04em}
  .card .style{color:var(--muted);font-size:13.5px;margin-top:-6px}
  .card .tubes{font-family:var(--mono);font-size:12px;color:var(--faint)}
  .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:auto;padding-top:8px}
  .explore{margin:8px 0 28px}
  .explore-grid{margin-top:4px}
  .inline-link{color:var(--amber)}
</style>
