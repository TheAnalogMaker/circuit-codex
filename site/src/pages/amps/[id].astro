---
import Base from '../../layouts/Base.astro';
import { loadCorpus, displayId, ampMetaDescription, layoutAlt, layoutMinWidth, topologyHref, circuitFamilyMap, loadHistory, TOPOLOGY_DIMENSIONS, loadLoadlineStages, toneStackPresetIds, GITHUB } from '../../lib/corpus.js';

export async function getStaticPaths() {
  const stages = new Map(loadLoadlineStages().map((s) => [s.amp, s]));
  return loadCorpus().map((amp) => ({
    params: { id: amp.id },
    props: { amp, loadline: stages.get(amp.id) ?? null },
  }));
}
const { amp, loadline } = Astro.props;
const m = amp.meta;
const v = m.verification || {};
const vDate = v.date ? new Date(v.date).toISOString().slice(0, 10) : null;
const ghDir = `${GITHUB}/tree/main/amps/${amp.id}`;
const wiringVerified = amp.layout?.wiring_claim === 'verified';
// Floor width for the board drawing, so a wide board is scrolled rather than
// scaled down past legibility. See layoutMinWidth() in lib/corpus.js.
const layoutFloor = layoutMinWidth(amp);
const isVerified = v.status === 'verified';
// --- lineage (explore) — related circuits documented in this amp's meta.yaml,
//     limited to those present in the corpus so links never 404. Rendered as one
//     row in the metadata panel below. Delimited for hand-merge.
const _corpusAmps = loadCorpus();
const _corpusIds = new Set(_corpusAmps.map((a) => a.id));
// The amp's history family (model line), reverse-mapped from circuit_ref in the
// history tier — a link to its era timeline on the /history/ page.
const historyFamily = circuitFamilyMap().get(amp.id) || null;
const lineageRelated = [
  ...new Set([...(m.lineage?.derived_from || []), ...(m.lineage?.influenced || [])]),
].filter((rid) => _corpusIds.has(rid) && rid !== amp.id);
// True when the circuit carries no published voltage chart at all — every node is
// simulation-only (chart: null). Such pages must not promise chart comparison.
const allChartNull = !!amp.voltages && Object.values(amp.voltages.nodes)
  .every((e) => e.chart === null || e.chart === undefined);
// How to name the output bottles in prose. The corpus runs 1, 2 and — since the
// Model 1959 Super Lead — 4 of them, so "pair" cannot be the answer for every
// push-pull stage. Anything the words below do not cover falls back to the ×N
// notation the load-line explorer's own preset chips use.
const OUTPUT_GROUP_WORD = { 1: '', 2: 'pair', 3: 'trio', 4: 'quartet', 6: 'sextet' };
function outputGroup(tube, n) {
  const word = OUTPUT_GROUP_WORD[n];
  if (word === '') return tube;
  return word ? `${tube} ${word}` : `${tube} ×${n}`;
}
// --- tone-stack lab link (delimited for hand-merge; remove to revert) ---
// True where the interactive tone-stack lab carries a preset built from this
// circuit's own parts list, so the panel row can offer its response curve.
const hasToneStackLab = toneStackPresetIds().has(amp.id);
// --- end tone-stack lab link ---
// --- related circuits (below Sources; delimited for hand-merge) — real crawl
// paths for a reader who has just read this circuit: other documented amps in
// its history family line, plus amps sharing its phase-inverter or tone-stack
// topology, each group also linking the matching cross-cut page. Budgeted to
// ~5 links total so the block stays a hand-picked path, not a link dump — when
// it would run over, sibling-amp links are trimmed from the least-specific
// groups first, but every present group keeps its one cross-cut link.
const RELATED_LINK_BUDGET = 5;
const relatedGroups = [];
if (historyFamily) {
  const famSiblingIds = (loadHistory().find((f) => f.slug === historyFamily.slug)?.models || [])
    .filter((mo) => mo.documented && mo.ampId !== amp.id)
    .map((mo) => mo.ampId);
  if (famSiblingIds.length) {
    relatedGroups.push({
      label: 'Same family line',
      ampIds: famSiblingIds,
      crossCutHref: `/history/${historyFamily.slug}/`,
      crossCutText: `${historyFamily.title} ↗`,
    });
  }
}
for (const dimKey of ['phase_inverter', 'tone_stack']) {
  const value = m.topology?.[dimKey];
  if (!value || value === 'none') continue;
  const href = topologyHref(dimKey, m);
  if (!href) continue;
  const siblingIds = _corpusAmps
    .filter((a) => a.id !== amp.id && a.meta.topology?.[dimKey] === value)
    .map((a) => a.id);
  if (!siblingIds.length) continue;
  const dim = TOPOLOGY_DIMENSIONS.find((d) => d.key === dimKey);
  relatedGroups.push({
    label: dimKey === 'phase_inverter' ? 'Same phase inverter' : 'Same tone stack',
    ampIds: siblingIds,
    crossCutHref: href,
    crossCutText: `${dim?.values[value]?.label || value} — every amp ↗`,
  });
}
// Every present group keeps its one cross-cut link no matter what (that link
// never 404s and is always on-topic) — those are spent first. What is left of
// the budget is handed out as amp-sibling links one at a time, round-robin in
// group order (family line first, most specific), capped at 2 per group, so
// three groups at the default budget read as 1 sibling + 1 sibling + cross-cut-
// only rather than silently dropping a whole group.
const MAX_AMP_LINKS_PER_GROUP = 2;
for (const g of relatedGroups) g.ampLinks = [];
let linkCount = relatedGroups.length;
let grew = true;
while (grew && linkCount < RELATED_LINK_BUDGET) {
  grew = false;
  for (const g of relatedGroups) {
    if (linkCount >= RELATED_LINK_BUDGET) break;
    if (g.ampLinks.length < Math.min(MAX_AMP_LINKS_PER_GROUP, g.ampIds.length)) {
      g.ampLinks.push(g.ampIds[g.ampLinks.length]);
      linkCount++;
      grew = true;
    }
  }
}
// --- end related circuits ---
const metaDescription = ampMetaDescription(m);
const canonical = new URL(`amps/${amp.id}/`, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${displayId(amp.id)} — ${m.name_style}`,
  name: `${displayId(amp.id)} — ${m.name_style}`,
  description: metaDescription,
  url: canonical,
  inLanguage: 'en',
  about: `${m.name_style} guitar amplifier circuit`,
  ...(vDate ? { datePublished: vDate } : {}),
  publisher: { '@type': 'Organization', name: 'Circuit Codex' },
};
// Two crumbs, deliberately: the circuits index IS the homepage (there is no
// /circuits/ page, only the /#circuits section), and a middle crumb pointing at
// a fragment of position 1's own URL adds no navigational level. Schema.org and
// Google's rich-result rules are both satisfied by a two-item BreadcrumbList.
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: displayId(amp.id), url: `/amps/${amp.id}/` },
];
---
<Base title={`${displayId(amp.id)} — ${m.name_style} · Circuit Codex`}
      description={metaDescription} ogType="article" jsonld={jsonld} breadcrumbs={breadcrumbs}
      ogImage={`og/${amp.id}.png`}
      ogImageAlt={`${displayId(amp.id)} — ${m.name_style}, ${m.wattage} W: Circuit Codex card, with a detail of the redrawn board layout drawing`}>

<div class="wrap wrap-wide">
  <header class="amp-head">
    <h1>{displayId(amp.id)} <span class="style">{m.name_style} · {m.era.start}–{m.era.end} · {m.wattage} W</span></h1>
    {v.status === 'verified'
      ? <span class="chip ok">✓ verified {vDate}</span>
      : <span class="chip">draft</span>}
  </header>

  <div class="cols">
    <div class="main">
      <div class="viewer">
        <div class="viewer-head">Schematic — redrawn in KiCad · scroll to zoom, drag to pan</div>
        {amp.hasSchematic ? (
          <div class="viewer-canvas">
            <script type="module" src="/vendor/kicanvas.js" is:inline></script>
            <kicanvas-embed src={`/schematics/${amp.id}.kicad_sch`} controls="basic"
              aria-label={`Interactive schematic: ${m.name_style} ${displayId(amp.id)}, redrawn in KiCad`}></kicanvas-embed>
            <noscript><p class="viewer-fallback">Interactive schematic requires JavaScript.
              Download the redrawn KiCad schematic for {displayId(amp.id)}:
              <a href={`${ghDir}/schematic.kicad_sch`}>schematic.kicad_sch</a>.</p></noscript>
          </div>
        ) : (
          <div class="viewer-body">
            <p>Redrawn KiCad schematic in progress. The simulation-checked
              <a href={`${ghDir}/netlist.cir`}> netlist</a> is already available —
              every voltage below derives from it.</p>
          </div>
        )}
      </div>

      {amp.hasLayout && (
        <div class="viewer layout">
          <div class="viewer-head">
            <span>Board layout — redrawn reference diagram · source noted on the drawing</span>
            {amp.hasLayoutSheet && (
              <span class="layout-tools">
                {/* The style buttons only do something with JS, so they stay
                    hidden until the script below reveals them; the print link
                    is an ordinary link and works either way. */}
                <span class="layout-styles" role="group" aria-label="Board drawing style" hidden>
                  <button type="button" class="sbtn" data-style="sheet" aria-pressed="true">Sheet</button>
                  <button type="button" class="sbtn" data-style="current" aria-pressed="false">Current</button>
                </span>
                <a class="sbtn" href={`/layouts/${amp.id}-sheet.svg`} target="_blank"
                   rel="noopener">Print sheet ↗</a>
              </span>
            )}
          </div>
          <div class="layout-canvas">
            {amp.hasLayoutSheet && (
              <img src={`/layouts/${amp.id}-sheet.svg`} loading="lazy" decoding="async"
                data-layout="sheet" alt={layoutAlt(amp, 'sheet')}
                style={layoutFloor ? `min-width:${layoutFloor}px` : undefined} />
            )}
            <img src={`/layouts/${amp.id}.svg`} loading="lazy" decoding="async"
              data-layout="current" alt={layoutAlt(amp, 'current')}
              hidden={amp.hasLayoutSheet}
              style={layoutFloor ? `min-width:${layoutFloor}px` : undefined} />
          </div>
          <p class="layout-scroll-note">
            Scroll the drawing sideways to read the whole board, or
            <a href={amp.hasLayoutSheet ? `/layouts/${amp.id}-sheet.svg` : `/layouts/${amp.id}.svg`}
               target="_blank" rel="noopener"
               data-full-current={`/layouts/${amp.id}.svg`}
               data-full-sheet={`/layouts/${amp.id}-sheet.svg`}> open the
            full-size diagram</a> in its own tab.
            {amp.hasLayoutSheet && (
              <span data-style-note="sheet"> Values are lettered on the parts in the
                period shorthand — <b>.02-400</b>, <b>250-5</b>, <b>1MEG</b>:
                <a href="/reference/guides/units-conventions/#era-shorthand"> how to
                read it</a>.</span>
            )}
          </p>
          <p class="layout-note">
            {wiringVerified && (
              <><strong>Machine-checked wiring.</strong> Every modelled part the operating-point
              netlist places on this board — the tube sockets, the plate, cathode and grid-leak
              resistors, the power-rail droppers, and the coupling and bypass capacitors whose two
              leads are both named DC nodes — has been verified in CI, terminal for terminal, to be
              electrically equivalent to {isVerified
                ? 'the simulated netlist this circuit is verified against'
                : "the circuit's simulated netlist"}: the same net structure, no missing or extra connections. Parts outside
              that DC model — the volume / tone / mixer control-network internals, the
              negative-bias front end, and the heater chain, pilot lamp and power-transformer /
              rectifier AC side — are drawn from the cited sources but are <em>not</em>
              machine-checked; the CI report enumerates every one of their terminals so the
              boundary is explicit rather than silent. </>
            )}
            This diagram documents connectivity and part arrangement — it is not a
            dimensioned 1:1 build template. Board and part positions are drawn at
            diagram scale, and lead dress, grounding paths, and physical spacing all
            matter in a high-voltage chassis. If you build from it, verify every
            connection against the schematic above and the operating-point table
            below as you go.
          </p>
        </div>
      )}

      {amp.voltages && (
        <section>
          <h2>{allChartNull ? 'Simulated operating point' : 'Operating point vs. published chart'}</h2>
          {allChartNull
            ? <p class="sub">No published voltage chart exists for this circuit — the factory
                drawing prints component values only. The voltages below are informational
                results simulated from the redrawn netlist, not read from or checked against any
                chart. Because there is no measured reference to verify against, this circuit is
                published as a draft.</p>
            : <p class="sub">Chart values read from the published drawing — or, where the drawing carries no voltage chart, from the cited published measurements (never reproduced).
                Tolerances are this project's verification targets: tube-pin nodes carry the
                tolerance the cited source states, or ±20% — the era's printed convention —
                where it states none, and power rails are held to tighter internal targets.
                {isVerified && ` Simulation matches every node within target — worst deviation ${v.max_deviation_pct}%.`}</p>}
          <div class="tbl"><table>
            <thead><tr><th>Node</th><th>Chart</th><th>Tolerance</th><th>Note</th></tr></thead>
            <tbody>
              {Object.entries(amp.voltages.nodes).map(([node, e]) => (
                <tr>
                  <td>{node}</td>
                  <td>{e.chart === null || e.chart === undefined ? '—' : `${e.chart} V`}</td>
                  <td>{e.disputed ? <span class="chip">chart disputed</span> : (e.chart === null || e.chart === undefined ? '' : `±${e.tol_pct ?? 5}%`)}</td>
                  <td style="font-family:var(--body);color:var(--faint)">{e.dispute_note || e.note || ''}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
          {allChartNull
            ? <p class="footnote">Every node here is simulation-only — there is no published
                chart to check against — so no chart column or tolerance is shown.</p>
            : <p class="footnote">Tube-pin nodes are checked at the tolerance the cited source
                states, or at the era's ±20% convention where it states none; power-rail nodes are
                held to tighter internal verification targets.</p>}
          {/* LOADLINE-LINK — delimited for hand-merge. Only for circuits whose output
              stage pipeline/export_loadlines.py could read out of the netlist. */}
          {loadline && (
            <p class="footnote">The output stage behind these numbers can be drawn:
              the <a href={`/reference/guides/load-lines/?preset=${amp.id}`}>load line
              explorer</a> plots this circuit's {outputGroup(loadline.tube, loadline.output_tubes)} at
              the DC operating point its netlist carries — {Math.round(loadline.plate_v)} V on the
              plates with {loadline.bias === 'cathode'
                ? `a ${loadline.rk_total} Ω cathode resistor`
                : `a ${String(loadline.grid_v).replace('-', '−')} V grid bias`} — and marks where the load line
              crosses.{!isVerified && ' This circuit is published as a draft, so that operating point is not verified against a published chart: the table and notes above say what each figure rests on.'}</p>
          )}
          {/* /LOADLINE-LINK */}
        </section>
      )}

      {amp.bom && (
        <section>
          <h2>Parts list</h2>
          <p class="sub">{amp.hasSchematic
            ? 'Reference designators match the schematic above.'
            : 'Reference designators follow the corpus convention; the redrawn schematic is in progress.'} {amp.bom.notes}</p>
          <div class="tbl"><table>
            <thead><tr><th>Ref</th><th>Part</th><th>Value / rating</th><th>Role</th></tr></thead>
            <tbody>
              {amp.bom.items.map((i) => (
                <tr>
                  <td style="color:var(--amber)">{i.ref}</td>
                  <td style="font-family:var(--body)">{i.part}</td>
                  <td>{i.value}</td>
                  <td style="font-family:var(--body);color:var(--faint)">{i.role}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
        </section>
      )}

      {amp.notesHtml && (
        <section>
          <h2>Circuit story</h2>
          <div class="notes" set:html={amp.notesHtml} />
        </section>
      )}
    </div>

    <aside class="meta">
      <dl>
        <dt>Circuit</dt><dd>{displayId(amp.id)}</dd>
        {m.family !== 'other' && <><dt>Family</dt><dd>{m.family}</dd></>}
        {historyFamily && (
          <>
            <dt>Family line</dt>
            <dd><a href={`/history/${historyFamily.slug}/`}>{historyFamily.title} ↗</a></dd>
          </>
        )}
        <dt>Output</dt><dd>{m.wattage} W</dd>
        <dt>Tubes</dt><dd>{m.tubes.join(', ')}</dd>
        <dt>Rectifier</dt><dd>{topologyHref('rectifier', m)
          ? <a href={topologyHref('rectifier', m)}>{m.topology.rectifier.type || m.topology.rectifier.kind}</a>
          : (m.topology.rectifier.type || m.topology.rectifier.kind)}</dd>
        <dt>Bias</dt><dd>{topologyHref('bias', m)
          ? <a href={topologyHref('bias', m)}>{m.topology.bias}</a> : m.topology.bias}</dd>
        <dt>Phase inv.</dt><dd>{topologyHref('phase_inverter', m)
          ? <a href={topologyHref('phase_inverter', m)}>{m.topology.phase_inverter}</a> : m.topology.phase_inverter}</dd>
        <dt>Tone stack</dt><dd>{topologyHref('tone_stack', m)
          ? <a href={topologyHref('tone_stack', m)}>{m.topology.tone_stack}</a> : m.topology.tone_stack}
          {/* --- tone-stack lab link; remove this fragment to revert --- */}
          {hasToneStackLab && (
            <> · <a href={`/reference/guides/tone-stack-lab/?preset=${amp.id}#lab`}>hear the curve ↗</a></>
          )}
          {/* --- end tone-stack lab link --- */}</dd>
        {/* --- lineage row (explore surface); remove this block to revert --- */}
        {lineageRelated.length > 0 && (
          <>
            <dt>Lineage</dt>
            <dd>{lineageRelated.map((rid, i) => (
              <>{i > 0 ? ', ' : ''}<a href={`/amps/${rid}/`}>{displayId(rid)}</a></>
            ))} · <a href="/lineage/">tree ↗</a></dd>
          </>
        )}
        {/* --- end lineage row --- */}
      </dl>
      <div class="files">
        <h3>Data</h3>
        <a href={`${ghDir}/meta.yaml`}>meta.yaml</a>
        {amp.hasNetlist && <a href={`${ghDir}/netlist.cir`}>netlist.cir</a>}
        {amp.voltages && <a href={`${ghDir}/voltages.yaml`}>voltages.yaml</a>}
        <a href={ghDir}>browse directory →</a>
      </div>
    </aside>
  </div>

  {m.sources && (
    <section class="sources">
      <h2>Sources</h2>
      <ul class="src">{m.sources.map((s) => (
        <li>{typeof s === 'string' ? s : (<>
          {s.desc}{s.url && <> — <a href={s.url} rel="external nofollow">{new URL(s.url).hostname}</a></>}
        </>)}</li>
      ))}</ul>
    </section>
  )}

  {/* --- related circuits; remove this block to revert --- */}
  {relatedGroups.length > 0 && (
    <section class="related">
      <h2>Related circuits</h2>
      <dl class="rel">
        {relatedGroups.map((g) => (
          <>
            <dt>{g.label}</dt>
            <dd>{g.ampLinks.map((rid, i) => (
              <>{i > 0 ? ', ' : ''}<a href={`/amps/${rid}/`}>{displayId(rid)}</a></>
            ))} · <a href={g.crossCutHref}>{g.crossCutText}</a></dd>
          </>
        ))}
      </dl>
    </section>
  )}
  {/* --- end related circuits --- */}
</div>

<script is:inline>
  // Board-drawing style toggle. Both drawings ship in the page; this swaps which
  // one is shown, remembers the reader's choice across amp pages, and keeps the
  // "open the full-size diagram" link pointing at whichever is on screen. It is
  // inline and runs on parse so the remembered style is applied before paint.
  (function () {
    var box = document.querySelector('.viewer.layout');
    if (!box) return;
    var group = box.querySelector('.layout-styles');
    if (!group) return;                       // this board has one drawing only
    var KEY = 'cc-layout-style';
    var imgs = box.querySelectorAll('img[data-layout]');
    var full = box.querySelector('a[data-full-sheet]');
    var btns = group.querySelectorAll('button[data-style]');
    var notes = box.querySelectorAll('[data-style-note]');
    var pending = 0;
    function apply(style, defer) {
      var token = ++pending;
      var next = null;
      for (var i = 0; i < imgs.length; i++)
        if (imgs[i].dataset.layout === style) next = imgs[i];
      function swap() {
        // A deferred swap that a later choice has superseded must not fire:
        // its fetch or its timeout can land after the reader has moved on.
        if (token !== pending) return;
        for (var i = 0; i < imgs.length; i++) imgs[i].hidden = imgs[i].dataset.layout !== style;
      }
      for (var j = 0; j < btns.length; j++)
        btns[j].setAttribute('aria-pressed', btns[j].dataset.style === style ? 'true' : 'false');
      for (var n = 0; n < notes.length; n++)
        notes[n].hidden = notes[n].dataset.styleNote !== style;
      if (full) full.href = style === 'sheet' ? full.dataset.fullSheet : full.dataset.fullCurrent;
      if (defer && next && !next.complete) {
        // The drawing that is not on screen is deferred, so the first switch to
        // it has to fetch it. Hold the current one in place until it is ready:
        // otherwise the figure collapses to nothing and the page jumps. The
        // fetch has to go through a detached image — a lazy <img> that is still
        // `hidden` has no box to intersect the viewport, so it would never load
        // while we waited on it, and waiting on it is the whole point.
        var pre = new Image();
        pre.onload = pre.onerror = swap;
        pre.src = next.src;
        setTimeout(swap, 2500);        // never leave the reader waiting on a stall
      } else {
        swap();
      }
    }
    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) { /* storage blocked */ }
    apply(saved === 'current' ? 'current' : 'sheet', false);
    group.hidden = false;
    for (var k = 0; k < btns.length; k++) {
      btns[k].addEventListener('click', function () {
        apply(this.dataset.style, true);
        try { localStorage.setItem(KEY, this.dataset.style); } catch (e) { /* ignore */ }
      });
    }
    // Left/right move between the two buttons, as a grouped control should.
    group.addEventListener('keydown', function (ev) {
      if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
      var list = [].slice.call(btns);
      var i = list.indexOf(document.activeElement);
      if (i < 0) return;
      ev.preventDefault();
      list[(i + (ev.key === 'ArrowRight' ? 1 : list.length - 1)) % list.length].focus();
    });
  })();
</script>
</Base>

<style>
  .amp-head{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;padding:56px 0 8px}
  h1{font-size:38px;letter-spacing:.05em;margin:0}
  /* The subtitle now lives inside the h1 (one heading for SEO/a11y) but keeps its
     original look: body font, sentence case, muted, lighter than the display title. */
  h1 .style{font-family:var(--body);text-transform:none;font-weight:400;letter-spacing:normal;font-size:16px;color:var(--muted);white-space:normal}
  .wrap-wide{max-width:1140px}
  .cols{display:grid;grid-template-columns:1fr minmax(280px,340px);gap:24px;align-items:start;margin-top:16px}
  /* A grid item's automatic minimum size is its min-content width, so the board
     drawing's min-width (see layoutMinWidth) would widen the 1fr track to the
     width of the whole drawing and scroll the PAGE sideways instead of the
     figure. Letting the tracks shrink is what lets .layout-canvas do the
     scrolling it is given overflow-x for. */
  .cols>*{min-width:0}
  @media(max-width:820px){.cols{grid-template-columns:1fr}}
  .viewer{background:var(--well);border:1px solid var(--line);border-radius:8px;margin-bottom:24px}
  .viewer-head{padding:10px 16px;border-bottom:1px solid var(--line-soft);font-family:var(--disp);text-transform:uppercase;letter-spacing:.12em;font-size:11.5px;color:var(--muted);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  /* Board-drawing style toggle + print link. Same button treatment as the
     load-line explorer's controls, sized down to sit on the viewer's head rule. */
  .layout-tools{margin-left:auto;display:flex;align-items:center;gap:8px}
  .layout-styles{display:flex;gap:0}
  .sbtn{background:var(--well);border:1px solid var(--line);color:var(--muted);font-family:var(--disp);text-transform:uppercase;letter-spacing:.12em;font-size:10.5px;padding:4px 10px;cursor:pointer;border-radius:5px;line-height:1.5}
  .layout-styles .sbtn{border-radius:0}
  .layout-styles .sbtn:first-child{border-radius:5px 0 0 5px}
