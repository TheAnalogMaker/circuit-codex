---
import Base from '../../layouts/Base.astro';
import { loadCorpus, displayId, ampMetaDescription, layoutAlt, layoutMinWidth, topologyHref, circuitFamilyMap, loadHistory, TOPOLOGY_DIMENSIONS, loadLoadlineStages, toneStackPresetIds, ampOpPoints, designatorScheme, listPhrase, GITHUB } from '../../lib/corpus.js';

export async function getStaticPaths() {
  const stages = new Map(loadLoadlineStages().map((s) => [s.amp, s]));
  return loadCorpus().map((amp) => ({
    params: { id: amp.id },
    props: { amp, loadline: stages.get(amp.id) ?? null },
  }));
}
const { amp, loadline } = Astro.props;
const m = amp.meta;
const v = m.verification || {};
const vDate = v.date ? new Date(v.date).toISOString().slice(0, 10) : null;
const ghDir = `${GITHUB}/tree/main/amps/${amp.id}`;
const wiringVerified = amp.layout?.wiring_claim === 'verified';
// Floor width for the board drawing, so a wide board is scrolled rather than
// scaled down past legibility. See layoutMinWidth() in lib/corpus.js.
const layoutFloor = layoutMinWidth(amp);
const isVerified = v.status === 'verified';
// --- lineage (explore) — related circuits documented in this amp's meta.yaml,
//     limited to those present in the corpus so links never 404. Rendered as one
//     row in the metadata panel below. Delimited for hand-merge.
const _corpusAmps = loadCorpus();
const _corpusIds = new Set(_corpusAmps.map((a) => a.id));
// The amp's history family (model line), reverse-mapped from circuit_ref in the
// history tier — a link to its era timeline on the /history/ page.
const historyFamily = circuitFamilyMap().get(amp.id) || null;
const lineageRelated = [
  ...new Set([...(m.lineage?.derived_from || []), ...(m.lineage?.influenced || [])]),
].filter((rid) => _corpusIds.has(rid) && rid !== amp.id);
// True when the circuit carries no published voltage chart at all — every node is
// simulation-only (chart: null). Such pages must not promise chart comparison.
const allChartNull = !!amp.voltages && Object.values(amp.voltages.nodes)
  .every((e) => e.chart === null || e.chart === undefined);
// Operating-point rows: the published chart joined to the simulated value the
// verification run exported, with each row's deviation computed from the two
// numbers standing beside it. See ampOpPoints() in lib/corpus.js.
const opRows = ampOpPoints(amp);
// Voltages print with one decimal and a real minus sign, matching the house
// units style used elsewhere on the page (−40 V, not -40 V).
const volts = (n) => `${String(Number(n).toFixed(1)).replace('-', '−')} V`;
const chartVolts = (n) => `${String(n).replace('-', '−')} V`;
// A long dispute note is arithmetic, not a table cell: the row shows its first
// sentence and opens the rest on demand, so one disputed node cannot triple the
// height of every row around it.
function leadSentence(s, max = 96) {
  const text = String(s || '').trim();
  if (text.length <= max) return { lead: text, rest: '' };
  const stop = text.slice(0, max + 40).search(/[.:;]\s/);
  const cut = stop > 24 ? stop + 1 : text.lastIndexOf(' ', max);
  // A clause cut at a colon or semicolon is not a sentence: close it with an
  // ellipsis so the summary reads as the start of something rather than as a
  // statement that trails off mid-punctuation.
  const lead = text.slice(0, cut).trim().replace(/[:;,]$/, '') + (/[.!?]$/.test(text.slice(0, cut).trim()) ? '' : ' …');
  return { lead, rest: text.slice(cut).trim() };
}
// What this parts list may claim about its designators, read from the amp's own
// BOM and the presence of a redrawn schematic — see designatorScheme().
const refs = designatorScheme(amp);
// Small counts read as words in prose; a sentence never opens with a numeral.
const COUNT_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven',
  'eight', 'nine', 'ten', 'eleven', 'twelve'];
const countWord = (n) => {
  const w = COUNT_WORDS[n];
  return w ? w.charAt(0).toUpperCase() + w.slice(1) : String(n);
};
// How to name the output bottles in prose. The corpus runs 1, 2 and — since the
// Model 1959 Super Lead — 4 of them, so "pair" cannot be the answer for every
// push-pull stage. Anything the words below do not cover falls back to the ×N
// notation the load-line explorer's own preset chips use.
// The valve named here is the one the drawing letters (loadline.tube_lettered),
// not the SPICE model the netlist instantiates: the whole 6L6 family shares one
// clean-room fit, so a 6L6GB pair would otherwise read "5881 pair" on its page.
const OUTPUT_GROUP_WORD = { 1: '', 2: 'pair', 3: 'trio', 4: 'quartet', 6: 'sextet' };
function outputGroup(tube, n) {
  const word = OUTPUT_GROUP_WORD[n];
  if (word === '') return tube;
  return word ? `${tube} ${word}` : `${tube} ×${n}`;
}
// --- tone-stack lab link (delimited for hand-merge; remove to revert) ---
// True where the interactive tone-stack lab carries a preset built from this
// circuit's own parts list, so the panel row can offer its response curve.
const hasToneStackLab = toneStackPresetIds().has(amp.id);
// --- end tone-stack lab link ---
// --- related circuits (below Sources; delimited for hand-merge) — real crawl
// paths for a reader who has just read this circuit: other documented amps in
// its history family line, plus amps sharing its phase-inverter or tone-stack
// topology, each group also linking the matching cross-cut page. Budgeted to
// ~6 links so three groups can each keep one sibling plus the cross-cut — when
// it would run over, sibling-amp links are trimmed from the least-specific
// groups first, but every present group keeps its one cross-cut link.
const RELATED_LINK_BUDGET = 6;
const relatedGroups = [];
if (historyFamily) {
  const famSiblingIds = (loadHistory().find((f) => f.slug === historyFamily.slug)?.models || [])
    .filter((mo) => mo.documented && mo.ampId !== amp.id)
    .map((mo) => mo.ampId);
  if (famSiblingIds.length) {
    relatedGroups.push({
      label: 'Same family line',
      ampIds: famSiblingIds,
      crossCutHref: `/history/${historyFamily.slug}/`,
      crossCutText: `${historyFamily.title} ↗`,
    });
  }
}
for (const dimKey of ['phase_inverter', 'tone_stack']) {
  const value = m.topology?.[dimKey];
  if (!value || value === 'none') continue;
  const href = topologyHref(dimKey, m);
  if (!href) continue;
  const siblingIds = _corpusAmps
    .filter((a) => a.id !== amp.id && a.meta.topology?.[dimKey] === value)
    .map((a) => a.id);
  if (!siblingIds.length) continue;
  const dim = TOPOLOGY_DIMENSIONS.find((d) => d.key === dimKey);
  relatedGroups.push({
    label: dimKey === 'phase_inverter' ? 'Same phase inverter' : 'Same tone stack',
    ampIds: siblingIds,
    crossCutHref: href,
    crossCutText: `${dim?.values[value]?.label || value} — every amp ↗`,
  });
}
// Every present group keeps its one cross-cut link no matter what (that link
// never 404s and is always on-topic) — those are spent first. What is left of
// the budget is handed out as amp-sibling links one at a time, round-robin in
// group order (family line first, most specific), capped at 2 per group, so
// three groups at the default budget read as one sibling each plus the
// cross-cut, rather than leaving the last group as a hanging separator.
const MAX_AMP_LINKS_PER_GROUP = 2;
for (const g of relatedGroups) g.ampLinks = [];
let linkCount = relatedGroups.length;
let grew = true;
while (grew && linkCount < RELATED_LINK_BUDGET) {
  grew = false;
  for (const g of relatedGroups) {
    if (linkCount >= RELATED_LINK_BUDGET) break;
    if (g.ampLinks.length < Math.min(MAX_AMP_LINKS_PER_GROUP, g.ampIds.length)) {
      g.ampLinks.push(g.ampIds[g.ampLinks.length]);
      linkCount++;
      grew = true;
    }
  }
}
// --- end related circuits ---
const metaDescription = ampMetaDescription(m);
const canonical = new URL(`amps/${amp.id}/`, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${displayId(amp.id)} — ${m.name_style}`,
  name: `${displayId(amp.id)} — ${m.name_style}`,
  description: metaDescription,
  url: canonical,
  inLanguage: 'en',
  about: `${m.name_style} guitar amplifier circuit`,
  ...(vDate ? { datePublished: vDate } : {}),
  publisher: { '@type': 'Organization', name: 'Circuit Codex' },
};
// Two crumbs, deliberately: the circuits index IS the homepage (there is no
// /circuits/ page, only the /#circuits section), and a middle crumb pointing at
// a fragment of position 1's own URL adds no navigational level. Schema.org and
// Google's rich-result rules are both satisfied by a two-item BreadcrumbList.
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: displayId(amp.id), url: `/amps/${amp.id}/` },
];
// The per-amp social card is a crop of that amp's own board drawing, so
// pipeline/render_og.py only builds one for a circuit that has a layout. A
// circuit that has not been drawn yet falls back to the site card rather than
// naming an image that was never rendered — see the ogImage prop below.
// The h1 subtitle sets the style name with non-breaking hyphens (U+2011), so a
// phone cannot break "Tweed Deluxe-style" into "Deluxe-" / "style". Display
// only — the data, the <title>, and the structured data keep the plain hyphen.
const styleNoBreak = String(m.name_style).replace(/-/g, '‑');
---
<Base title={`${displayId(amp.id)} — ${m.name_style} · Circuit Codex`}
      description={metaDescription} ogType="article" jsonld={jsonld} breadcrumbs={breadcrumbs}
      ogImage={`og/${amp.id}.png`}
      ogImageAlt={amp.hasLayout
        ? `${displayId(amp.id)} — ${m.name_style}, ${m.wattage} W: Circuit Codex card, with a detail of the redrawn board layout drawing`
        : undefined}>

<div class="wrap wrap-wide">
  <header class="amp-head">
    <h1>{displayId(amp.id)} <span class="style">{styleNoBreak} · {m.era.start}–{m.era.end} · {m.wattage} W</span></h1>
    {v.status === 'verified'
      ? <span class="chip ok">✓ verified {vDate}</span>
      : <span class="chip">draft</span>}
    <nav class="jump" aria-label="On this page">
      {amp.hasSchematic && <a href="#schematic">Schematic</a>}
      {amp.hasLayout && <a href="#layout">Layout</a>}
      <a href="#op-point">Operating point</a>
      <a href="#parts">Parts</a>
      <a href="#story">Story</a>
      <a href="#sources">Sources</a>
    </nav>
  </header>

  <div class="cols">
    <div class="main figures">
      <div class="viewer" id="schematic">
        <div class="viewer-head">Schematic — redrawn in KiCad · scroll to zoom, drag to pan</div>
        {amp.hasSchematic ? (
          <div class="viewer-canvas">
            <script type="module" src="/vendor/kicanvas.js" is:inline></script>
            <kicanvas-embed src={`/schematics/${amp.id}.kicad_sch`} controls="basic"
              aria-label={`Interactive schematic: ${m.name_style} ${displayId(amp.id)}, redrawn in KiCad`}></kicanvas-embed>
            <noscript><p class="viewer-fallback">Interactive schematic requires JavaScript.
              Download the redrawn KiCad schematic for {displayId(amp.id)}:
              <a href={`${ghDir}/schematic.kicad_sch`}>schematic.kicad_sch</a>.</p></noscript>
          </div>
        ) : (
          <div class="viewer-body">
            <p>Redrawn KiCad schematic in progress. The simulation-checked
              <a href={`${ghDir}/netlist.cir`}> netlist</a> is already available —
              every voltage below derives from it.</p>
          </div>
        )}
      </div>

      {amp.hasLayout && (
        <div class="viewer layout" id="layout" style={layoutFloor ? `--layout-floor:${layoutFloor}px` : undefined}>
          <div class="viewer-head">
            <span>Board layout — redrawn reference diagram · source noted on the drawing</span>
            {/* Shown only when the drawing really is wider than its box — the
                measurement lives in the script below. A styled scrollbar is not
                enough on its own: several platforms hide theirs until something
                moves, which makes a cut-off drawing look like a broken one. */}
            <span class="scroll-flag" hidden>scrolls ↔</span>
            {amp.hasLayoutSheet && (
              <span class="layout-tools">
                {/* The style buttons only do something with JS, so they stay
                    hidden until the script below reveals them; the print link
                    is an ordinary link and works either way. */}
                <span class="layout-styles" role="group" aria-label="Board drawing style" hidden>
                  <button type="button" class="sbtn" data-style="sheet" aria-pressed="true">Sheet</button>
                  <button type="button" class="sbtn" data-style="current" aria-pressed="false">Current</button>
                </span>
                <a class="sbtn" href={`/layouts/${amp.id}-sheet.svg`} target="_blank"
                   rel="noopener">Print sheet ↗</a>
              </span>
            )}
          </div>
          {/* The drawing's own scroll container. Its scrollable width is the whole
              drawing — board, caption and the colour/joint/body legend beneath it,
              all inside one viewBox — so nothing on the sheet is unreachable, only
              off-screen until scrolled. It is focusable because a region a mouse can
              scroll must be scrollable from the keyboard too. */}
          <div class="layout-canvas" tabindex="0" role="group"
               aria-label={`${displayId(amp.id)} board drawing`}>
            {amp.hasLayoutSheet && (
              <img src={`/layouts/${amp.id}-sheet.svg`} loading="lazy" decoding="async"
                data-layout="sheet" alt={layoutAlt(amp, 'sheet')} />
            )}
            <img src={`/layouts/${amp.id}.svg`} loading="lazy" decoding="async"
              data-layout="current" alt={layoutAlt(amp, 'current')}
              hidden={amp.hasLayoutSheet} />
          </div>
          <p class="layout-scroll-note">
            {/* Which of these two the reader gets is measured, not assumed: a board
                that already fits must not be told to scroll. The overflow variant is
                the one served, since most boards overflow and it is the safe reading
                if the measuring script never runs. */}
            <span data-fit="over">Scroll the drawing sideways to read the whole board —
              the source line and the colour legend run along the bottom of the sheet — or
              <a href={amp.hasLayoutSheet ? `/layouts/${amp.id}-sheet.svg` : `/layouts/${amp.id}.svg`}
                 target="_blank" rel="noopener"
                 data-full-current={`/layouts/${amp.id}.svg`}
                 data-full-sheet={`/layouts/${amp.id}-sheet.svg`}> open the
              full-size diagram</a> in its own tab.</span>
            <span data-fit="fits" hidden>The whole board is on screen, source line and
              colour legend included.
              <a href={amp.hasLayoutSheet ? `/layouts/${amp.id}-sheet.svg` : `/layouts/${amp.id}.svg`}
                 target="_blank" rel="noopener"
                 data-full-current={`/layouts/${amp.id}.svg`}
                 data-full-sheet={`/layouts/${amp.id}-sheet.svg`}> Open the
              full-size diagram</a> in its own tab to zoom in or print it.</span>
            {amp.hasLayoutSheet && (
              <span data-style-note="sheet"> Values are lettered on the parts in the
                period shorthand — <b>.02-400</b>, <b>250-5</b>, <b>1MEG</b>:
                <a href="/reference/guides/units-conventions/#era-shorthand"> how to
                read it</a>.</span>
            )}
          </p>
          {/* The claim and the caveat stay in view; what "modelled part" covers,
              where the check stops, and the build warning's reasoning open on
              demand. As one paragraph this ran to ~190 words under every board
              drawing, a wall on a phone before the reader reached the table. */}
          <div class="layout-note">
            <p>
              {wiringVerified && (
                <><strong>Machine-checked wiring.</strong> Every modelled part the operating-point
                netlist places on this board has been verified in CI, terminal for terminal, to be
                electrically equivalent to {isVerified
                  ? 'the simulated netlist this circuit is verified against'
                  : "the circuit's simulated netlist"}. </>
              )}
              This diagram documents connectivity and part arrangement — it is not a
              dimensioned 1:1 build template.
            </p>
            <details>
              <summary>Details</summary>
              {wiringVerified && (
                <p>The modelled parts are the tube sockets, the plate, cathode and grid-leak
                resistors, the power-rail droppers, and the coupling and bypass capacitors whose
                two leads are both named DC nodes; the check proves the same net structure, with
                no missing or extra connections. Parts outside that DC model — the volume / tone /
                mixer control-network internals, the negative-bias front end, and the heater chain,
                pilot lamp and power-transformer / rectifier AC side — are drawn from the cited
                sources but are <em>not</em> machine-checked; the CI report enumerates every one of
                their terminals so the boundary is explicit rather than silent.</p>
              )}
              <p>Board and part positions are drawn at diagram scale, and lead dress, grounding
              paths, and physical spacing all matter in a high-voltage chassis. If you build from
              it, verify every connection against the schematic above and the operating-point
              table below as you go.</p>
            </details>
          </div>
        </div>
      )}
    </div>

    <aside class="meta">
      <dl>
        <dt>Circuit</dt><dd>{displayId(amp.id)}</dd>
        {m.family !== 'other' && <><dt>Family</dt><dd>{m.family}</dd></>}
        {historyFamily && (
          <>
            <dt>Family line</dt>
            <dd><a href={`/history/${historyFamily.slug}/`}>{historyFamily.title} ↗</a></dd>
          </>
        )}
        <dt>Output</dt><dd>{m.wattage} W</dd>
        <dt>Tubes</dt><dd>{m.tubes.join(', ')}</dd>
        <dt>Rectifier</dt><dd>{topologyHref('rectifier', m)
          ? <a href={topologyHref('rectifier', m)}>{m.topology.rectifier.type || m.topology.rectifier.kind}</a>
          : (m.topology.rectifier.type || m.topology.rectifier.kind)}</dd>
        <dt>Bias</dt><dd>{topologyHref('bias', m)
          ? <a href={topologyHref('bias', m)}>{m.topology.bias}</a> : m.topology.bias}</dd>
        <dt>Phase inv.</dt><dd>{topologyHref('phase_inverter', m)
          ? <a href={topologyHref('phase_inverter', m)}>{m.topology.phase_inverter}</a> : m.topology.phase_inverter}</dd>
        <dt>Tone stack</dt><dd>{topologyHref('tone_stack', m)
          ? <a href={topologyHref('tone_stack', m)}>{m.topology.tone_stack}</a> : m.topology.tone_stack}
          {/* --- tone-stack lab link; remove this fragment to revert --- */}
          {hasToneStackLab && (
            <> · <a href={`/reference/guides/tone-stack-lab/?preset=${amp.id}#lab`}>hear the curve ↗</a></>
          )}
          {/* --- end tone-stack lab link --- */}</dd>
        {/* --- lineage row (explore surface); remove this block to revert --- */}
        {lineageRelated.length > 0 && (
          <>
            <dt>Lineage</dt>
            <dd>{lineageRelated.map((rid, i) => (
              <>{i > 0 ? ', ' : ''}<a href={`/amps/${rid}/`}>{displayId(rid)}</a></>
            ))} · <a href="/lineage/">tree ↗</a></dd>
          </>
        )}
        {/* --- end lineage row --- */}
      </dl>
      <div class="files">
        <h3>Data</h3>
        <a href={`${ghDir}/meta.yaml`}>meta.yaml</a>
        {amp.hasNetlist && <a href={`${ghDir}/netlist.cir`}>netlist.cir</a>}
        {amp.voltages && <a href={`${ghDir}/voltages.yaml`}>voltages.yaml</a>}
        <a href={ghDir}>browse directory →</a>
      </div>
    </aside>

    <div class="main body">
      {amp.voltages && (
        <section>
          <h2 id="op-point">{allChartNull ? 'Simulated operating point' : 'Operating point vs. published chart'}</h2>
          {allChartNull
            ? <p class="sub">No published voltage chart exists for this circuit — the factory
                drawing prints component values only. The voltages below are informational
                results simulated from the redrawn netlist, not read from or checked against any
                chart. Because there is no measured reference to verify against, this circuit is
                published as a draft.</p>
            : <p class="sub">Chart values read from the published drawing — or, where the drawing carries no voltage chart, from the cited published measurements (never reproduced).
                The simulated column is this circuit's own netlist solved in ngspice by the run
                that gates it; every deviation beside it is those two numbers compared, not a
                separately stated figure. Tolerances are this project's verification targets:
                tube-pin nodes carry the
                tolerance the cited source states, or ±20% — the era's printed convention —
                where it states none, and power rails are held to tighter internal targets.
                {isVerified && ` Every gated node lands within target — worst deviation ${v.max_deviation_pct}%.`}</p>}
          <div class="tbl"><table class="ops">
            <thead><tr>
              <th>Node</th>
              {!allChartNull && <th>Chart</th>}
              <th>Simulated</th>
              {!allChartNull && <th>Deviation</th>}
              {!allChartNull && <th>Tolerance</th>}
              <th>Note</th>
            </tr></thead>
            <tbody>
              {opRows.map((r) => (
                <tr class={r.disputed ? 'row-disputed' : undefined}>
                  <td class="node">{r.node}{r.disputed && <><br /><span class="flag">chart disputed</span></>}</td>
                  {!allChartNull && <td>{r.chart === null ? '—' : chartVolts(r.chart)}</td>}
                  <td class="sim">{r.sim === null ? '—' : volts(r.sim)}</td>
                  {!allChartNull && (
                    <td class={r.dev_pct === null ? '' : (r.disputed ? 'dev off-chart' : (r.within ? 'dev ok' : 'dev over'))}>
                      {r.dev_pct === null ? '—' : `${r.dev_pct.toFixed(1)}%`}
                    </td>
                  )}
                  {!allChartNull && <td>{r.chart === null ? '—' : (r.disputed ? 'not gated' : `±${r.tol_pct}%`)}</td>}
                  <td class="note">
                    {r.disputed && r.dispute_note
                      ? (leadSentence(r.dispute_note).rest
                          ? <details><summary>{leadSentence(r.dispute_note).lead}</summary>
                              <p>{leadSentence(r.dispute_note).rest}</p></details>
                          : leadSentence(r.dispute_note).lead)
                      : (r.note || '')}
                  </td>
                </tr>
              ))}
            </tbody>
          </table></div>
          {allChartNull
            ? <p class="footnote">Every node here is simulation-only — there is no published
                chart to check against — so no chart, deviation or tolerance column is shown.</p>
            : <p class="footnote">Tube-pin nodes are checked at the tolerance the cited source
                states, or at the era's ±20% convention where it states none; power-rail nodes are
                held to tighter internal verification targets.
                {opRows.some((r) => r.disputed) && ' A node marked chart disputed is excluded from that check — its printed value contradicts the rest of the chart, and the note says how; its deviation is shown for the record, not as a result.'}
                {' '}Simulated figures are the netlist's DC solution, not measurements from a
                chassis.</p>}
          {/* LOADLINE-LINK — delimited for hand-merge. Only for circuits whose output
              stage pipeline/export_loadlines.py could read out of the netlist. */}
          {loadline && (
            <p class="footnote">The output stage behind these numbers can be drawn:
              the <a href={`/reference/guides/load-lines/?preset=${amp.id}`}>load line
              explorer</a> plots this circuit's {outputGroup(loadline.tube_lettered ?? loadline.tube, loadline.output_tubes)} at
              the DC operating point its netlist carries — {Math.round(loadline.plate_v)} V on the
              plates with {loadline.bias === 'cathode'
                ? `a ${loadline.rk_total} Ω cathode resistor`
                : `a ${String(loadline.grid_v).replace('-', '−')} V grid bias`} — and marks where the load line
              crosses.{!isVerified && ' This circuit is published as a draft, so that operating point is not verified against a published chart: the table and notes above say what each figure rests on.'}</p>
          )}
          {/* /LOADLINE-LINK */}
        </section>
      )}

      {amp.bom && (
        <section>
          <h2 id="parts">Parts list</h2>
          <p class="sub">
            {refs.crossChecked
              ? "Every designator in this list appears on the schematic above, and every designator on the schematic appears here — the two are checked against each other in both directions, a valve's two halves counting as one bottle (V1A and V1B are both V1)."
              : "Reference designators follow the corpus convention; the redrawn schematic is in progress, so this list is not yet checked against one."}
            {refs.undesignated > 0 && (refs.undesignated === 1
              ? ' One part the drawing carries as an annotation rather than a numbered symbol is listed here without a designator, and stands outside that check.'
              : ` ${countWord(refs.undesignated)} parts the drawing carries as annotations rather than numbered symbols are listed here without designators, and stand outside that check.`)}
            {refs.tubeGaps.length > 0 && ` Valve numbers are the source drawing's own and are not renumbered here to close a gap: this circuit carries ${listPhrase(refs.tubes)}, and a number missing from that run is a valve the circuit does not carry.`}
            {' '}{amp.bom.notes}</p>
          <div class="tbl"><table class="bom">
            <thead><tr><th>Ref</th><th>Part</th><th class="val">Value / rating</th><th>Role</th></tr></thead>
            <tbody>
              {amp.bom.items.map((i) => (
                <tr>
                  <td style="color:var(--amber)">{i.ref}</td>
                  <td style="font-family:var(--body)">{i.part}</td>
                  {/* House units style joins a value to its rating with a middle
                      dot ("250 kΩ · ½ W"). Each side is one quantity and must not
                      break inside itself — a column narrow enough to wrap "½ W"
                      onto its own line was reading as a half-stated rating — so the
                      tokens are emitted individually and only the separator wraps. */}
                  <td class="val">{String(i.value ?? '').split(' · ').map((tok, n) => (
                    <>{n > 0 ? <span class="sep"> · </span> : ''}<span class="tok">{tok}</span></>
                  ))}</td>
                  <td style="font-family:var(--body);color:var(--faint)">{i.role}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
        </section>
      )}

      {amp.notesHtml && (
        <section>
          <h2 id="story">Circuit story</h2>
          <div class="notes" set:html={amp.notesHtml} />
        </section>
      )}
    </div>
  </div>

  {m.sources && (
    <section class="sources">
      <h2 id="sources">Sources</h2>
      <ul class="src">{m.sources.map((s) => (
        <li>{typeof s === 'string' ? s : (<>
          {s.desc}{s.url && <> — <a href={s.url} rel="external nofollow">{new URL(s.url).hostname}</a></>}
        </>)}</li>
      ))}</ul>
    </section>
  )}

  {/* --- related circuits; remove this block to revert --- */}
  {relatedGroups.length > 0 && (
    <section class="related">
      <h2>Related circuits</h2>
      <dl class="rel">
        {relatedGroups.map((g) => (
          <>
            <dt>{g.label}</dt>
            <dd>{g.ampLinks.map((rid, i) => (
              <>{i > 0 ? ', ' : ''}<a href={`/amps/${rid}/`}>{displayId(rid)}</a></>
            ))}{g.ampLinks.length > 0 ? ' · ' : ''}<a href={g.crossCutHref}>{g.crossCutText}</a></dd>
          </>
        ))}
      </dl>
    </section>
  )}
  {/* --- end related circuits --- */}
</div>

<script is:inline>
  // Board-drawing style toggle. Both drawings ship in the page; this swaps which
  // one is shown, remembers the reader's choice across amp pages, and keeps the
  // "open the full-size diagram" link pointing at whichever is on screen. It is
  // inline and runs on parse so the remembered style is applied before paint.
  (function () {
    var box = document.querySelector('.viewer.layout');
    if (!box) return;
    // Does the drawing overflow its scroll container right now? The scroll note
    // says one thing when it does and another when it does not, and neither is
    // guessed: a board that fits must not tell the reader to scroll, and one that
    // overflows must say what is off the right edge. Re-measured on resize, since
    // the drawing takes the column's width down to its own floor.
    var can = box.querySelector('.layout-canvas');
    function fit() {
      var over = can.scrollWidth - can.clientWidth > 1;
      box.setAttribute('data-overflow', over ? 'true' : 'false');
      var notes = box.querySelectorAll('[data-fit]');
      for (var i = 0; i < notes.length; i++)
        notes[i].hidden = notes[i].dataset.fit !== (over ? 'over' : 'fits');
      var flag = box.querySelector('.scroll-flag');
      if (flag) flag.hidden = !over;
    }
    fit();
    if (window.ResizeObserver) new ResizeObserver(fit).observe(can);
    else window.addEventListener('resize', fit);
    // The drawings load lazily, so the first measurement can precede the layout
    // the loaded image settles into.
    var loading = box.querySelectorAll('img[data-layout]');
    for (var L = 0; L < loading.length; L++) loading[L].addEventListener('load', fit);
    var group = box.querySelector('.layout-styles');
    if (!group) return;                       // this board has one drawing only
    var KEY = 'cc-layout-style';
    var imgs = box.querySelectorAll('img[data-layout]');
    var full = box.querySelectorAll('a[data-full-sheet]');
    var btns = group.querySelectorAll('button[data-style]');
    var notes = box.querySelectorAll('[data-style-note]');
    var pending = 0;
    function apply(style, defer) {
      var token = ++pending;
      var next = null;
      for (var i = 0; i < imgs.length; i++)
        if (imgs[i].dataset.layout === style) next = imgs[i];
      function swap() {
        // A deferred swap that a later choice has superseded must not fire:
        // its fetch or its timeout can land after the reader has moved on.
        if (token !== pending) return;
        for (var i = 0; i < imgs.length; i++) imgs[i].hidden = imgs[i].dataset.layout !== style;
        fit();   // both styles share a viewBox, but measure rather than assume
      }
      for (var j = 0; j < btns.length; j++)
        btns[j].setAttribute('aria-pressed', btns[j].dataset.style === style ? 'true' : 'false');
      for (var n = 0; n < notes.length; n++)
        notes[n].hidden = notes[n].dataset.styleNote !== style;
      for (var f = 0; f < full.length; f++)
        full[f].href = style === 'sheet' ? full[f].dataset.fullSheet : full[f].dataset.fullCurrent;
      if (defer && next && !next.complete) {
        // The drawing that is not on screen is deferred, so the first switch to
        // it has to fetch it. Hold the current one in place until it is ready:
        // otherwise the figure collapses to nothing and the page jumps. The
        // fetch has to go through a detached image — a lazy <img> that is still
        // `hidden` has no box to intersect the viewport, so it would never load
        // while we waited on it, and waiting on it is the whole point.
        var pre = new Image();
        pre.onload = pre.onerror = swap;
        pre.src = next.src;
        setTimeout(swap, 2500);        // never leave the reader waiting on a stall
      } else {
        swap();
      }
    }
    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) { /* storage blocked */ }
    apply(saved === 'current' ? 'current' : 'sheet', false);
    group.hidden = false;
    for (var k = 0; k < btns.length; k++) {
      btns[k].addEventListener('click', function () {
        apply(this.dataset.style, true);
        try { localStorage.setItem(KEY, this.dataset.style); } catch (e) { /* ignore */ }
      });
    }
    // Left/right move between the two buttons, as a grouped control should.
    group.addEventListener('keydown', function (ev) {
      if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
      var list = [].slice.call(btns);
      var i = list.indexOf(document.activeElement);
      if (i < 0) return;
      ev.preventDefault();
      list[(i + (ev.key === 'ArrowRight' ? 1 : list.length - 1)) % list.length].focus();
    });
  })();
</script>
</Base>

<style>
  .amp-head{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;padding:56px 0 8px}
  .jump{flex-basis:100%;display:flex;flex-wrap:wrap;gap:6px 14px;margin:4px 0 0;
    font-family:var(--disp);text-transform:uppercase;letter-spacing:.12em;font-size:11.5px}
  .jump a{color:var(--muted)}
  #schematic,#layout,#op-point,#parts,#story,#sources{scroll-margin-top:72px}
  h1{font-size:38px;letter-spacing:.05em;margin:0}
  /* The subtitle now lives inside the h1 (one heading for SEO/a11y) but keeps its
     original look: body font, sentence case, muted, lighter than the display title. */
  h1 .style{font-family:var(--body);text-transform:none;font-weight:400;letter-spacing:normal;font-size:16px;color:var(--muted);white-space:normal}
  /* An amp page is figure-led: a board drawing and a schematic sheet set its
     width, not a line of prose. On a large screen the wrap opens up so those
     figures get the room — every prose block on the page carries its own
     measure cap (70–90ch), so the extra width lands on the drawings and the
     tables rather than stretching sentences. Base.astro widens the nav and
     footer wraps at the same breakpoint so the page keeps one alignment. */
  .wrap-wide{max-width:1140px}
  @media(min-width:1440px){.wrap-wide{max-width:1320px}}
  /* Three grid items — the two figures, the metadata panel, and the tables and
     story — placed by area. From 1200px up the panel is a sticky right-hand
     column spanning both rows; below that a two-column grid was squeezing the
     schematic viewer to half a laptop screen and the operating-point table's
     Note column into a ~600px table, so everything stacks: figures, then the
     panel, then the tables, each at the full width of the page. Rows carry no
     gap of their own — the headings' margins space them, as they did when the
     tables and figures shared one block. */
  .cols{display:grid;grid-template-columns:1fr minmax(280px,340px);grid-template-areas:"figures meta" "body meta";column-gap:24px;row-gap:0;align-items:start;margin-top:16px}
  /* A grid item's automatic minimum size is its min-content width, so the board
     drawing's min-width (see layoutMinWidth) would widen the 1fr track to the
     width of the whole drawing and scroll the PAGE sideways instead of the
     figure. Letting the tracks shrink is what lets .layout-canvas do the
     scrolling it is given overflow-x for. */
  .cols>*{min-width:0}
  .figures{grid-area:figures}
  .body{grid-area:body}
  .figures .viewer:last-child{margin-bottom:0}
  @media(max-width:1199px){
    .cols{grid-template-columns:1fr;grid-template-areas:"figures" "meta" "body"}
  }
  /* The panel's own single-column rules sit after its base rules, below. */
  .viewer{background:var(--well);border:1px solid var(--line);border-radius:8px;margin-bottom:24px}
  .viewer-head{padding:10px 16px;border-bottom:1px solid var(--line-soft);font-family:var(--disp);text-transform:uppercase;letter-spacing:.12em;font-size:11.5px;color:var(--muted);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  /* Board-drawing style toggle + print link. Same button treatment as the
     load-line explorer's controls, sized down to sit on the viewer's head rule. */
  .layout-tools{margin-left:auto;display:flex;align-items:center;gap:8px}
  .scroll-flag{font-family:var(--disp);text-transform:uppercase;letter-spacing:.12em;font-size:10px;
    color:var(--amber);border:1px solid var(--amber-dim);border-radius:99px;padding:1px 8px}
  .scroll-flag[hidden]{display:none}
  .layout-styles{display:flex;gap:0}
  .sbtn{background:var(--well);border:1px solid var(--line);color:var(--muted);font-family:var(--disp);text-transform:uppercase;letter-spacing:.12em;font-size:10.5px;padding:4px 10px;cursor:pointer;border-radius:5px;line-height:1.5}
  .layout-styles .sbtn{border-radius:0}
  .layout-styles .sbtn:first-child{border-radius:5px 0 0 5px}
  .layout-styles .sbtn:last-child{border-radius:0 5px 5px 0;border-left-width:0}
  .sbtn:hover{border-color:var(--amber-dim);color:var(--amber);text-decoration:none}
  .layout-styles .sbtn[aria-pressed="true"]{border-color:var(--amber);color:var(--amber);background:rgba(232,155,63,.09)}
  a.sbtn{white-space:nowrap}
  .viewer-body{padding:22px 18px;color:var(--muted);font-size:14.5px}
  .viewer-body p{margin:0}
  /* The schematic viewer fits a whole KiCad sheet into this box, so the box's
     size IS the drawing's size: at the old fixed 580 px in a 726 px column the
     sheet fitted to the width and left the circuit itself a band a few hundred
     pixels tall — a postage stamp. The panel now takes a share of the viewport
     height, floored so a laptop still gets a usable panel and capped so a tall
     display does not hand over a whole screen before the reader has seen there
     is a page under it. A sheet is wider than it is tall, so it still fits by
     width and leaves some ground above and below; closing that gap means
     cropping the sheet to its drawing, which is a change to the schematic
     itself, not to this box.

     The panel is sized from its own width rather than from a fixed number, so
     it stays roughly the shape of the thing it holds at every column width: a
     phone gets a panel a little taller than it is wide, a wide desktop column
     gets a big one, and neither hands the reader a tall box with a thin drawing
     stranded in the middle of it. `width:100%` is load-bearing there: with an
     aspect ratio and an auto width, a min-height resolves the box's WIDTH
     through the ratio instead of from its parent, and the panel grows wider
     than the column it sits in. */
  .viewer-canvas{width:100%;aspect-ratio:5/4;height:auto;min-height:300px;max-height:min(76vh,860px)}
  .viewer-canvas kicanvas-embed{display:block;width:100%;height:100%}
  /* The drawings are wider than the column and set their type in viewBox units,
     so scaling one to fit would make its labels unreadable. Scroll instead —
     the same treatment the lineage figure already uses. This box is the scroll
     container, and its scrollable width is the drawing's whole width (see
     --layout-floor below): the board, the source line and the footer legend all
     live in one viewBox, so scrolling reaches every part of the sheet. */
  .layout-canvas{padding:10px;overflow-x:auto;overscroll-behavior-x:contain}
  /* A drawing that overflows must SAY so. macOS hides overlay scrollbars until
     something moves, which left the only sign of the missing right-hand side —
     the legend running off the edge — looking like a rendering bug. Give the
     container a permanent track. */
  .layout-canvas{scrollbar-color:var(--amber-dim) var(--well)}
  .layout-canvas::-webkit-scrollbar{height:11px}
  .layout-canvas::-webkit-scrollbar-track{background:var(--well);border-top:1px solid var(--line-soft)}
  .layout-canvas::-webkit-scrollbar-thumb{background:var(--amber-dim);border-radius:99px;border:3px solid var(--well)}
  .layout-canvas::-webkit-scrollbar-thumb:hover{background:var(--amber)}
  .layout-canvas:focus-visible{outline:2px solid var(--amber);outline-offset:-2px;border-radius:6px}
  .layout-scroll-note{color:var(--faint);font-size:12px;margin:0;padding:0 16px 10px}
  .layout-scroll-note b{color:var(--muted);font-family:var(--mono);font-weight:400}
  .layout-scroll-note [hidden]{display:none}
  .layout-note{color:var(--muted);font-size:12.5px;line-height:1.55;margin:0;padding:10px 16px 14px;border-top:1px solid var(--line-soft);max-width:90ch}
  .layout-note p{margin:0}
  .layout-note details{margin-top:6px}
  .layout-note summary{cursor:pointer;color:var(--muted);font-family:var(--disp);text-transform:uppercase;letter-spacing:.12em;font-size:10.5px;width:fit-content}
  .layout-note summary:hover{color:var(--amber)}
  .layout-note details[open] summary{margin-bottom:6px}
  .layout-note details p+p{margin-top:6px}
  /* The drawing takes the column's width, but never shrinks below the floor the
     page computed for it (layoutMinWidth() in lib/corpus.js, handed down as
     --layout-floor on .viewer.layout). Both styles read the same property, so
     the two drawings of one board can never disagree about their own width. */
  .layout-canvas img{display:block;width:100%;min-width:var(--layout-floor,0);height:auto;border-radius:4px}
  /* An author `display` rule outranks the UA sheet's [hidden], so both the
     off-screen drawing and the no-JS toggle need it restated. */
  .layout-canvas img[hidden]{display:none}
  .layout-styles[hidden]{display:none}
  h2{font-size:17px;letter-spacing:.14em;margin:28px 0 4px}
  .sub{color:var(--muted);font-size:13.5px;margin:0 0 14px;max-width:70ch}
  .footnote{color:var(--faint);font-size:12px;margin:10px 0 0;max-width:70ch}
  /* ---- operating-point table ------------------------------------------------
     The chart and the simulation stand in adjacent columns with their deviation
     between them, so the heading's "vs." is something the reader can check
     rather than something the prose asserts. */
  .ops td{vertical-align:top}
  /* A voltage, a deviation or a tolerance is one token: the table scrolls
     sideways in a narrow box rather than breaking "295 V" into "295" / "V".
     Only the Note column wraps. */
  .ops td:not(.note){white-space:nowrap}
  .ops .node{white-space:nowrap;color:var(--ink)}
  .ops .sim{color:var(--ink)}
  .ops .dev{white-space:nowrap}
  .ops .dev.ok{color:var(--ok)}
  .ops .dev.over{color:var(--amber)}
  /* A disputed node's deviation is arithmetic for the record, not a result: it
     is neither pass nor fail, and must not be coloured as either. */
  .ops .dev.off-chart{color:var(--faint)}
  /* The dispute badge is a status on the node, not a tolerance. It used to sit
     in the Tolerance column, where it read as the tolerance itself. */
  .ops .flag{display:inline-block;margin-top:3px;font-family:var(--disp);text-transform:uppercase;
    letter-spacing:.1em;font-size:9.5px;color:var(--oxblood);border:1px solid var(--oxblood);
    border-radius:99px;padding:1px 7px;white-space:nowrap}
  .ops .note{font-family:var(--body);color:var(--faint);min-width:26ch;max-width:46ch}
  /* Dispute notes carry the arithmetic that makes the dispute checkable — four
     to six lines of it, which used to set the height of every row on the page.
     The row shows the claim; the working opens under it. */
  .ops .note details summary{cursor:pointer;color:var(--muted)}
  .ops .note details[open] summary{margin-bottom:4px}
  .ops .note details p{margin:0;color:var(--faint)}
  .ops tr.row-disputed td{background:rgba(156,74,56,.06)}
  /* ---- parts list ---------------------------------------------------------
     "250 kΩ · ½ W" is two quantities, not seven words: the column keeps enough
     room for the common case and each quantity stays whole, so a narrow window
     can break the line at the separator but never inside "½ W". */
  .bom .val{min-width:14ch}
  .bom .val .tok{white-space:nowrap}
  .bom .val .sep{color:var(--faint)}
  .viewer-fallback{padding:22px 18px;color:var(--muted);font-size:14.5px;margin:0}
  .meta{grid-area:meta;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px;position:sticky;top:72px}
  .meta dl{margin:0;display:grid;grid-template-columns:max-content 1fr;gap:9px 14px;font-size:14px}
  .meta dt{color:var(--faint);text-transform:uppercase;font-family:var(--disp);letter-spacing:.1em;font-size:11px;padding-top:2px}
  .meta dd{margin:0;font-family:var(--mono);font-size:12.5px;overflow-wrap:anywhere;line-height:1.5}
  .files{margin-top:16px;border-top:1px dashed var(--line);padding-top:12px;display:flex;flex-direction:column;gap:6px}
  .files h3{font-size:12px;letter-spacing:.14em;margin:0 0 2px;color:var(--faint)}
  .files a{font-family:var(--mono);font-size:12.5px}
  /* Single-column form of the panel (see .cols above). These rules must FOLLOW
     the base .meta/.files rules: at equal specificity the later one wins, and a
     copy of this block placed above them left the panel sticky in the single
     column — pinned over the top of the operating-point table as the reader
     scrolled. Stacked under the figures on a tablet or laptop, the panel is wide
     and its rows are short: two key/value pairs per row and the data links in a
     row keep it a panel rather than a column of air. */
  @media(max-width:1199px){
    .meta{position:static;margin-top:24px}
  }
  @media(max-width:1199px) and (min-width:640px){
    .meta dl{grid-template-columns:max-content 1fr max-content 1fr;column-gap:18px}
    .files{flex-direction:row;flex-wrap:wrap;gap:6px 18px;align-items:baseline}
    .files h3{flex-basis:100%}
  }
  .sources{max-width:76ch}
  .src{margin:0;padding-left:16px;font-size:13px;color:var(--faint)}
  .src li{margin-bottom:6px}
  /* --- related circuits --- */
  .related{max-width:76ch;margin-top:28px}
  .rel{margin:0;display:grid;grid-template-columns:max-content 1fr;gap:9px 14px;font-size:13.5px}
  .rel dt{color:var(--faint);text-transform:uppercase;font-family:var(--disp);letter-spacing:.1em;font-size:11px;padding-top:2px}
  .rel dd{margin:0;color:var(--muted);line-height:1.5}
  /* --- end related circuits --- */
  .notes :global(h2){font-size:15px;letter-spacing:.12em;margin:22px 0 6px}
  .notes :global(p){color:var(--muted);font-size:14.5px;max-width:72ch}
  .notes :global(li){color:var(--muted);font-size:14.5px}
  .notes :global(table){font-size:13px;margin:10px 0}
  .notes :global(strong){color:var(--ink)}
  /* Printing the page: the board drawing is the part worth paper, so it prints
     whole rather than scrolled, and the on-screen controls drop out. (The
     "Print sheet" link opens the layout-sheet SVG standalone — that file is
     already a light-ground drawing sized to its own viewBox, so a browser
     prints it directly.) */
  @media print{
    .layout-tools,.scroll-flag{display:none}
    .viewer.layout{border:none;background:none;break-inside:avoid}
    .layout-canvas{overflow:visible;padding:0}
    .layout-canvas img{min-width:0 !important;width:100%}
    .layout-scroll-note{display:none}
    /* Paper gets the whole note, disclosure open or not. */
    .layout-note details::details-content{content-visibility:visible}
  }
</style>
