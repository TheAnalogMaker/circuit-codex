---
import Base from '../../layouts/Base.astro';
import { loadCorpus, loadHistory, displayId, GITHUB } from '../../lib/corpus.js';

// ---------------------------------------------------------------------------
// Lineage — a build-time family tree of the corpus. Every model in the history tier
// is placed on a horizontal era axis inside its family lane. Two kinds of connector,
// visually distinct:
//   • a light SUCCESSION line links the models within a family in chronological order
//     (the chain of revisions) — grouping, not a derivation claim;
//   • a solid ARROW is drawn only for a DOCUMENTED derivation BETWEEN two families
//     (recorded in an amp's own meta.yaml).
// Documented circuits render as solid chips linking their page; history-tier models
// (not yet a documented circuit) render as outline chips linking their family history.
// Nothing here is invented: positions come from era years, arrows from the metadata,
// and the prose under the figure enumerates the arrows from that same list rather
// than naming them by hand.
// ---------------------------------------------------------------------------
const amps = loadCorpus();
const byId = new Map(amps.map((a) => [a.id, a]));
const history = loadHistory();

// circuit id -> family slug (documented circuits only), to classify derivation edges
const famOfCircuit = new Map();
for (const fam of history) {
  for (const m of fam.models) if (m.documented) famOfCircuit.set(m.ampId, fam.slug);
}

// --- documented derivation edges (parent -> child) from the amps' own metadata.
const edgeSet = new Map();
function addEdge(parent, child) {
  if (!byId.has(parent) || !byId.has(child) || parent === child) return;
  edgeSet.set(`${parent}->${child}`, { parent, child });
}
for (const a of amps) {
  for (const p of a.meta.lineage?.derived_from || []) addEdge(p, a.id);
  for (const c of a.meta.lineage?.influenced || []) addEdge(a.id, c);
}
// Only CROSS-family derivations become arrows; within-family documented derivations
// are already carried by that family's succession line, so drawing an arrow too would
// double-state the same chain.
const crossEdges = [...edgeSet.values()].filter(
  (e) => famOfCircuit.get(e.parent) !== famOfCircuit.get(e.child));

// --- edge caption from the endpoints' structured metadata (power tubes + rectifier).
const PREAMP = /^(12A|ECC8|6AT6|6AV6|7025|5751|6SL7|6SC7|6SN7|EF86)/i;
function rectLabel(m) {
  const r = m.topology?.rectifier || {};
  if (r.kind === 'solid-state') return 'silicon';
  return r.type || r.kind || 'rect';
}
function powerTubes(m) {
  const rect = m.topology?.rectifier?.type;
  const out = [];
  for (const t of m.tubes || []) {
    if (PREAMP.test(t)) continue;
    if (rect && t === rect) continue;
    if (!out.includes(t)) out.push(t);
  }
  return out;
}
function edgeCaption(parent, child) {
  const mp = byId.get(parent).meta, mc = byId.get(child).meta;
  const pp = powerTubes(mp).join('+'), cp = powerTubes(mc).join('+');
  const parts = [];
  if (pp && cp && pp !== cp) parts.push(`${pp}→${cp}`);
  const pr = rectLabel(mp), cr = rectLabel(mc);
  if (pr !== cr) parts.push(`${pr}→${cr}`);
  // Every arrow carries a caption. Where a derivation keeps the same output tubes
  // and rectifier (the brown 6G3 Deluxe to the blackface AB763 Deluxe Reverb), the
  // change the data does record is the output rating, so that is what the chip reads.
  if (!parts.length && mp.wattage != null && mc.wattage != null && mp.wattage !== mc.wattage)
    parts.push(`${mp.wattage} W→${mc.wattage} W`);
  return parts.join(' · ');
}

// The family line a chip belongs to, in prose: "The Deluxe Reverb line" → "Deluxe
// Reverb". Used both to qualify a designation two lines share and to name an
// arrow's endpoints in the caption below the figure.
function lineName(fam) {
  return String(fam.title || fam.family).replace(/^the\s+/i, '').replace(/\s+line$/i, '');
}

// --- geometry --------------------------------------------------------------
// The era axis is derived from the corpus, never written down. Both tiers get a
// vote: the history files place every model (documented and ghost alike) and the
// amps' own `era` blocks are the authority for the documented ones. A hand-set
// span silently crops the chart as the corpus grows past it — the axis ran
// 1945–1982 while lanes reached 2000, so four production bars ran off the right
// edge and two later models were clamped to it, reading as 1980 introductions
// under a caption promising "bar spans production years".
const eraYears = [];
for (const fam of history)
  for (const m of fam.models) {
    if (m.years?.start != null) eraYears.push(m.years.start);
    if (m.years?.end != null) eraYears.push(m.years.end);
  }
for (const a of amps) {
  if (a.meta.era?.start != null) eraYears.push(a.meta.era.start);
  if (a.meta.era?.end != null) eraYears.push(a.meta.era.end);
}
// Gridlines every TICK years; the axis rounds out to the enclosing gridline so the
// oldest chip is never flush against the left pad, and carries TAIL_PAD years past
// the last gridline so the newest span bar and its end dot land inside the plot.
const TICK = 5, TAIL_PAD = 2;
const YEAR_MIN = Math.floor(Math.min(...eraYears) / TICK) * TICK;
const YEAR_MAX = Math.ceil(Math.max(...eraYears) / TICK) * TICK + TAIL_PAD;
// The corpus lives in the 1946–1968 cluster; the only chips past 1970 are a
// line's late chapters (a 1971 revision, a 1997 reissue). On a plain linear
// axis those few ghosts stretched the era axis to 2000 and packed every
// lane's real content into the left third of the chart — so the axis
// COMPRESSES after BREAK: one decade to the right of the break takes the
// width a half-decade takes to its left, the gridlines switch to ten-year
// steps there (the visible cue), and the figcaption states the compression.
// Still monotonic and still derived from the corpus, so nothing is cropped
// or clamped; only the tail's scale changes.
const BREAK = 1970, COMPRESS = 4;
const compressed = YEAR_MAX > BREAK + TICK;
const effYear = (yr) => (!compressed || yr <= BREAK)
  ? yr - YEAR_MIN
  : (BREAK - YEAR_MIN) + (yr - BREAK) / COMPRESS;
const EFF_SPAN = effYear(YEAR_MAX);
const W = 1300, PAD_L = 118, PAD_R = 30;
const X0 = PAD_L, X1 = W - PAD_R, PLOTW = X1 - X0;
const CW = 84, CH = 30, ROWH = 46, BAND_GAP = 14, BANDS_TOP = 34;
// Clearance a connector keeps from any chip it passes, and the minimum horizontal
// gap the row packer leaves between one chip's full extent (chip + production-span
// bar + its end dot) and the next chip's left edge.
const COL_PAD = 6, GAP_X = 16;

// A chip is as wide as the name it carries. CW is the floor, not the width: the
// labels run from "5E1" to "AA763 Deluxe Reverb", and a fixed box silently ran
// the long ones past their own border. The condensed display face sets about 6.9 px
// per uppercase character at 13 px, plus the ✓ a verified circuit adds and 9 px of
// padding each side. Widths feed the row packer below, so a wider chip takes the
// space it needs and its neighbours move down a sub-row rather than collide.
// A documented circuit's chip carries the designation that circuit is drawn under.
// Usually that is the id itself (5F6-A, AB763); where the family file qualifies it —
// JMI numbered its AC15 works drawings, and the one documented here is circuit No. 3 —
// the qualifier is part of the designation and is carried, so a solid chip is never
// a bare prefix of the ghost chip beside it.
function baseLabel(m) {
  if (!m.documented) return m.shortDesig;
  const id = displayId(m.ampId), desig = m.shortDesig;
  return desig.length > id.length && desig.toUpperCase().startsWith(id.toUpperCase()) ? desig : id;
}
// One designation can belong to two lines at once: Fender used AA763 for both the
// blackface Deluxe and the Deluxe Reverb that split off from it. Two chips reading
// the same text are indistinguishable on the chart, so any label that is not unique
// across the tree is qualified with its line.
const labelUses = new Map();
for (const fam of history)
  for (const m of fam.models) labelUses.set(baseLabel(m), (labelUses.get(baseLabel(m)) || 0) + 1);
function chipLabel(m, fam) {
  const base = baseLabel(m);
  return labelUses.get(base) > 1 ? `${base} ${lineName(fam)}` : base;
}
function chipWidth(m, fam) {
  const ver = m.documented && byId.get(m.ampId)?.meta.verification?.status === 'verified';
  return Math.max(CW, Math.round((chipLabel(m, fam).length + (ver ? 2 : 0)) * 6.9) + 18);
}
const xScale = (yr) => X0 + (effYear(yr) / EFF_SPAN) * PLOTW;

// Lane labels print the family's own name (lineName), not the internal slug —
// "Ampeg Portaflex", never "AMPEG-PORTAFLEX". A long name wraps to two lines
// at the most balanced space so it stays inside the label gutter.
function laneLines(fam) {
  const name = lineName(fam);
  if (name.length <= 16) return [name];
  const words = name.split(' ');
  if (words.length === 1) return [name];
  let best = [name], bestDiff = Infinity;
  for (let i = 1; i < words.length; i++) {
    const a = words.slice(0, i).join(' '), b2 = words.slice(i).join(' ');
    const d = Math.abs(a.length - b2.length);
    if (d < bestDiff) { bestDiff = d; best = [a, b2]; }
  }
  return best;
}

// Lane order: makers grouped, and inside the Fender group the lines run smallest to
// largest so the Bassman is the last Fender lane and the British group opens with the
// Marshall line directly under it — that is what makes the one documented cross-family
// arrow (5F6-A → JTM45) a short hop rather than a traverse of the whole chart.
// The maker grouping comes from each family file's own `maker_style`, so a lane whose
// slug nobody thought to list still lands with its countrymen (sorted by era within the
// group) instead of falling off the bottom of the chart — which is how six new lanes
// once ended up scattered under the British ones.
const MAKER_ORDER = ['Fender-style', 'British-style', 'American-style'];
const FAM_ORDER = [
  'champ', 'princeton', 'harvard', 'deluxe', 'deluxe-reverb', 'pro', 'super', 'twin', 'bassman',
  'marshall-lead', 'vox-ac', 'hiwatt',
  'supro-valco', 'ampeg-portaflex',
];
const makerRank = (f) => {
  const i = MAKER_ORDER.indexOf(String(f.maker_style || ''));
  return i === -1 ? MAKER_ORDER.length : i;
};
const famRank = (f) => FAM_ORDER.indexOf(f.slug) + 1 || 999;
const fams = [...history].sort((a, b) =>
  makerRank(a) - makerRank(b) || famRank(a) - famRank(b) ||
  (a.eraStart ?? 9999) - (b.eraStart ?? 9999) || a.slug.localeCompare(b.slug));

// greedy interval-pack a family's models into sub-rows so chips never overlap,
// preserving chronological order (left to right)
function packBand(models, fam) {
  // Stable sort: same-year models keep their authored (chronological) YAML order.
  const sorted = [...models].sort((a, b) => a.years.start - b.years.start);
  const rowEnds = [];
  const placed = [];
  for (const m of sorted) {
    const w = chipWidth(m, fam);
    let nx = xScale(m.years.start);
    if (nx + w > X1) nx = X1 - w;
    // A chip owns more than its box: the production-span bar runs to the model's end
    // year and finishes in a dot. Pack against that full extent, or a later chip in
    // the same row lands on its neighbour's span-end dot.
    const ext = Math.max(nx + w + 5, xScale(m.years.end)) + 4;
    let row = rowEnds.findIndex((end) => nx >= end + GAP_X);
    if (row === -1) { row = rowEnds.length; rowEnds.push(0); }
    rowEnds[row] = ext;
    placed.push({ m, nx, row, w });
  }
  return { placed, rows: rowEnds.length };
}

// --- connector routing ------------------------------------------------------
// A connector never crosses a chip: the chip text is the content, and a line through
// it is a defect. Every route is an orthogonal path — out of one chip's edge, along a
// clear vertical corridor, into the other's — with rounded corners. The corridor x is
// chosen from the gaps around the boxes the route would otherwise strike, so both the
// succession chains inside a dense lane and the derivation arrows that cross lanes go
// AROUND the chips between their endpoints rather than through them.
function inflate(b, p) { return { x: b.x - p, y: b.y - p, X: b.x + b.w + p, Y: b.y + b.h + p }; }
function segHits(x1, y1, x2, y2, r) {
  // every segment is axis-aligned, so a box-overlap test is exact
  return Math.min(x1, x2) <= r.X && Math.max(x1, x2) >= r.x &&
         Math.min(y1, y2) <= r.Y && Math.max(y1, y2) >= r.y;
}
// where a route leaves/enters a box, given the corridor it runs in
function anchorOn(box, other, gx) {
  if (gx >= box.x + 8 && gx <= box.x + box.w - 8) {
    const down = other.cy > box.cy;
    return { x: gx, y: down ? box.y + box.h : box.y, side: down ? 'down' : 'up' };
  }
  return gx > box.cx
    ? { x: box.x + box.w, y: box.cy, side: 'right' }
    : { x: box.x, y: box.cy, side: 'left' };
}
function routeAt(a, b, gx, rects) {
  const s = anchorOn(a, b, gx), t = anchorOn(b, a, gx);
  const raw = [[s.x, s.y], [gx, s.y], [gx, t.y], [t.x, t.y]];
  const pts = raw.filter((p, i) => i === 0 ||
    Math.abs(p[0] - raw[i - 1][0]) > 0.01 || Math.abs(p[1] - raw[i - 1][1]) > 0.01);
  let len = 0, clear = true;
  for (let i = 1; i < pts.length; i++) {
    len += Math.abs(pts[i][0] - pts[i - 1][0]) + Math.abs(pts[i][1] - pts[i - 1][1]);
    for (const r of rects)
      if (segHits(pts[i - 1][0], pts[i - 1][1], pts[i][0], pts[i][1], r)) clear = false;
  }
  return { pts, s, t, gx, clear, cost: len + (pts.length - 2) * 26 };
}
function routeBetween(a, b, obstacles) {
  const rects = obstacles.filter((o) => o !== a && o !== b).map((o) => inflate(o, COL_PAD));
  const cands = new Set([a.cx, b.cx, (a.x + a.w + b.x) / 2, (b.x + b.w + a.x) / 2]);
  for (const o of [a, b, ...obstacles]) {
    cands.add(o.x - COL_PAD - 10);
    cands.add(o.x + o.w + COL_PAD + 10);
  }
  let best = null;
  for (const gx of cands) {
    if (gx < X0 - 30 || gx > X1 + 20) continue;
    const r = routeAt(a, b, gx, rects);
    if (!r.clear) continue;
    if (!best || r.cost < best.cost) best = r;
  }
  return best || routeAt(a, b, (a.cx + b.cx) / 2, []);
}
// orthogonal point list → path with rounded corners
function pathOf(pts, r = 9) {
  let d = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1], [cx, cy] = pts[i], [nx, ny] = pts[i + 1];
    const d1 = Math.hypot(cx - px, cy - py), d2 = Math.hypot(nx - cx, ny - cy);
    if (d1 < 0.01 || d2 < 0.01) { d += ` L ${cx.toFixed(1)} ${cy.toFixed(1)}`; continue; }
    const rr = Math.max(0, Math.min(r, d1 / 2, d2 / 2));
    d += ` L ${(cx + ((px - cx) / d1) * rr).toFixed(1)} ${(cy + ((py - cy) / d1) * rr).toFixed(1)}` +
         ` Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${(cx + ((nx - cx) / d2) * rr).toFixed(1)} ${(cy + ((ny - cy) / d2) * rr).toFixed(1)}`;
  }
  const last = pts[pts.length - 1];
  return `${d} L ${last[0].toFixed(1)} ${last[1].toFixed(1)}`;
}

// lay bands top-to-bottom; resolve each model's box; build succession chains
const bands = [];
let y = BANDS_TOP;
for (const fam of fams) {
  if (!fam.models.length) continue;
  const { placed, rows } = packBand(fam.models, fam);
  const top = y, height = rows * ROWH;
  const pos = new Map();       // designation -> box (unique within a family)
  for (const p of placed) {
    const cy = top + p.row * ROWH + ROWH / 2;
    pos.set(p.m.designation, { x: p.nx, y: cy - CH / 2, cx: p.nx + p.w / 2, cy, w: p.w, h: CH });
  }
  // succession: consecutive chips joined edge to edge in chronological order, routed
  // around every other chip in the lane (a line that started at a chip's centre drew
  // over its own label, and one drawn centre-to-centre crossed the chips between).
  const boxes = [...pos.values()];
  const chrono = [...fam.models].sort((a, b) => a.years.start - b.years.start);
  const succ = [];
  for (let i = 0; i < chrono.length - 1; i++) {
    const a = pos.get(chrono[i].designation), b = pos.get(chrono[i + 1].designation);
    succ.push(pathOf(routeBetween(a, b, boxes).pts));
  }
  const nodes = placed.map((p) => ({ ...p, label: chipLabel(p.m, fam), box: pos.get(p.m.designation) }));
  bands.push({ fam, top, height, mid: top + height / 2, nodes, succ });
  y = top + height + BAND_GAP;
}
const AXIS_Y = y - BAND_GAP + 16;
const H = AXIS_Y + 38;
const ticks = [];
const preEnd = compressed ? BREAK : YEAR_MAX - TAIL_PAD;
for (let yr = YEAR_MIN; yr <= preEnd; yr += TICK) ticks.push(yr);
if (compressed)
  for (let yr = BREAK + 10; yr <= YEAR_MAX - TAIL_PAD; yr += 10) ticks.push(yr);

// every chip on the chart — the obstacle set a cross-lane arrow must clear
const allBoxes = [];
for (const b of bands) for (const n of b.nodes) allBoxes.push(n.box);
// documented-circuit chips, keyed by amp id, for the cross-family derivation arrows
const docNode = new Map();
for (const b of bands)
  for (const n of b.nodes)
    if (n.m.documented) docNode.set(n.m.ampId, { box: n.box, label: n.label, fam: b.fam });

const HEAD_L = 9, HEAD_W = 4.5;
const ARROW_DIR = { left: 'right', right: 'left', up: 'down', down: 'up' };
function headPoly(x, y, dir) {
  if (dir === 'right') return `${x.toFixed(1)},${y.toFixed(1)} ${(x - HEAD_L).toFixed(1)},${(y - HEAD_W).toFixed(1)} ${(x - HEAD_L).toFixed(1)},${(y + HEAD_W).toFixed(1)}`;
  if (dir === 'left') return `${x.toFixed(1)},${y.toFixed(1)} ${(x + HEAD_L).toFixed(1)},${(y - HEAD_W).toFixed(1)} ${(x + HEAD_L).toFixed(1)},${(y + HEAD_W).toFixed(1)}`;
  if (dir === 'down') return `${x.toFixed(1)},${y.toFixed(1)} ${(x - HEAD_W).toFixed(1)},${(y - HEAD_L).toFixed(1)} ${(x + HEAD_W).toFixed(1)},${(y - HEAD_L).toFixed(1)}`;
  return `${x.toFixed(1)},${y.toFixed(1)} ${(x - HEAD_W).toFixed(1)},${(y + HEAD_L).toFixed(1)} ${(x + HEAD_W).toFixed(1)},${(y + HEAD_L).toFixed(1)}`;
}
function edgeGeom(e) {
  const s = docNode.get(e.parent)?.box, t = docNode.get(e.child)?.box;
  if (!s || !t) return null;
  const r = routeBetween(s, t, allBoxes);
  const pts = r.pts.map((p) => [...p]);
  const dir = ARROW_DIR[r.t.side];
  const tip = [...pts[pts.length - 1]];
  // pull the shaft back to the base of the head
  const last = pts[pts.length - 1], prev = pts[pts.length - 2];
  if (prev) {
    const dx = Math.sign(last[0] - prev[0]), dy = Math.sign(last[1] - prev[1]);
    last[0] -= dx * HEAD_L; last[1] -= dy * HEAD_L;
  }
  const caption = edgeCaption(e.parent, e.child);
  const capLines = caption ? caption.split(' · ') : [];
  const capW = capLines.reduce((w, l) => Math.max(w, l.length), 0) * 6.0 + 10;
  const capH = capLines.length * 12 + 6;
  // Hang the caption on the longest leg of the route, at the first point along it
  // where the caption chip does not land on another chip. A 1.5-unit graze against a
  // chip's border is tolerated, so a caption is not thrown off the middle of its leg
  // by a box it only just touches.
  const rects = allBoxes.filter((b) => b !== s && b !== t).map((b) => inflate(b, -1.5));
  let leg = null, legLen = -1;
  for (let i = 1; i < pts.length; i++) {
    const L = Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
    if (L > legLen) { legLen = L; leg = [pts[i - 1], pts[i]]; }
  }
  let lx = (leg[0][0] + leg[1][0]) / 2, ly = (leg[0][1] + leg[1][1]) / 2;
  const clearAt = (px, py) => !rects.some((rr) =>
    segHits(px - capW / 2, py - capH / 2, px + capW / 2, py + capH / 2, rr));
  if (!clearAt(lx, ly)) {
    for (const f of [0.35, 0.65, 0.25, 0.75, 0.15, 0.85]) {
      const px = leg[0][0] + (leg[1][0] - leg[0][0]) * f;
      const py = leg[0][1] + (leg[1][1] - leg[0][1]) * f;
      if (clearAt(px, py)) { lx = px; ly = py; break; }
    }
  }
  return { d: pathOf(pts), head: headPoly(tip[0], tip[1], dir), capLines, capW, capH, lx, ly };
}
const drawnArrows = crossEdges.map((e) => ({ ...e, ...edgeGeom(e) })).filter((e) => e.d);

// The prose under the figure names the arrows the chart draws. It is generated from
// the same list the SVG is generated from, so a new documented cross-family
// derivation cannot silently make the caption a partial list.
const NUM = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
function edgePhrase(e) {
  const p = docNode.get(e.parent), c = docNode.get(e.child);
  return `the ${p.label} in the ${lineName(p.fam)} line to the ${c.label} in the ${lineName(c.fam)} line`;
}
function joinList(items) {
  if (items.length <= 1) return items.join('');
  if (items.length === 2) return `${items[0]}, and ${items[1]}`;
  return `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;
}
const arrowCount = drawnArrows.length;
const arrowList = joinList(drawnArrows.map(edgePhrase));
const arrowWord = `${NUM[arrowCount] ?? arrowCount} arrow${arrowCount === 1 ? '' : 's'}`;

const nModels = history.reduce((n, f) => n + f.models.length, 0);
const nDoc = history.reduce((n, f) => n + f.documentedCount, 0);
const title = 'Lineage — the family tree of classic guitar amp circuits · Circuit Codex';
const description =
  'A family tree of vintage guitar tube-amp circuits: every model placed on an era axis by family line, with a light succession line through each family and documented derivation arrows drawn only between families where the metadata records them — ' +
  `${arrowWord} in all, ${arrowList}. Documented circuits link their page; history-tier models link their family history.`;
const canonical = new URL('lineage/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'The lineage of classic guitar amplifier circuits',
  name: title,
  description,
  url: canonical,
  inLanguage: 'en',
  about: 'Guitar tube amplifier circuit lineage and derivation',
  publisher: { '@type': 'Organization', name: 'Circuit Codex' },
};
---
<Base title={title} description={description} jsonld={jsonld}>
<div class="wrap wrap-wide">
  <header class="page-head">
    <div class="eyebrow">Explore the corpus</div>
    <h1>Lineage</h1>
    <p class="lede">The circuits that made electric guitar did not appear in isolation — they
      descend from one another. This is the corpus as a family tree: every model placed on an
      era axis within its line, a <strong>succession line</strong> tracing each family's
      revisions, and a <strong>derivation arrow</strong> drawn wherever one circuit's redrawn
      schematic is a documented derivation of another in a <em>different</em> family.
      {nModels} models across {history.length} lines, {nDoc} with a documented circuit.
      Hover a lane to isolate it; click a solid chip for its circuit, an outline chip for its
      family history.</p>
  </header>

  <figure class="fig">
    <div class="scroll">
      <svg class="tree" viewBox={`0 0 ${W} ${H}`} role="img"
           aria-label="Family tree of the amp lines: every model arranged by family lane and era, with succession lines within families and documented derivation arrows between them.">
        <!-- year gridlines + axis -->
        <g class="grid">
          {ticks.map((yr) => (
            <g>
              <line x1={xScale(yr)} y1={22} x2={xScale(yr)} y2={AXIS_Y} />
              <text class="yr" x={xScale(yr)} y={AXIS_Y + 20}>{yr}</text>
            </g>
          ))}
          <line class="axis" x1={X0} y1={AXIS_Y} x2={X1} y2={AXIS_Y} />
          <!-- What a bar means lives in the legend row below, where HTML wraps
               and nothing clips — an SVG caption anchored to the plot's right
               border shipped truncated mid-word. -->
        </g>

        <!-- family lanes: succession chain + model chips, grouped for hover isolation -->
        {bands.map((b, i) => (
          <g class="fam">
            <rect class={i % 2 ? 'band-bg alt' : 'band-bg'} x={X0 - 8} y={b.top - 4}
                  width={PLOTW + 16} height={b.height - 8} rx="7" />
            <text class="lane" x={10} y={laneLines(b.fam).length === 1 ? b.mid : b.mid - 6.5}
                  dominant-baseline="middle">
              {laneLines(b.fam).map((l, li) => <tspan x={10} dy={li === 0 ? 0 : 13}>{l}</tspan>)}
            </text>
            {b.succ.map((d) => <path class="succ" d={d} fill="none" />)}
            {b.nodes.map((n) => {
              const m = n.m, box = n.box;
              const doc = m.documented;
              const ver = doc && byId.get(m.ampId)?.meta.verification?.status === 'verified';
              const href = doc ? `/amps/${m.ampId}/` : `/history/${b.fam.slug}/#m-${b.fam.models.indexOf(m)}`;
              const spanX2 = Math.max(xScale(m.years.end), box.x + box.w + 5);
              return (
                <a class={`node ${doc ? 'doc' : 'ghost'}`} href={href}>
                  <line class="span" x1={box.x + box.w - 2} y1={box.cy} x2={spanX2} y2={box.cy} />
                  <circle class="span-end" cx={spanX2} cy={box.cy} r="2.2" />
                  <rect class="chip" x={box.x} y={box.y} width={box.w} height={box.h} rx="6" />
                  {/* A model whose family file states no wattage gets a
                      name-only chip, centred — a bare em-dash where a number
                      should be reads as a rendering failure, not a gap. */}
                  <text class="cid" x={box.cx} y={box.y + (m.wattage != null ? 13 : 19)} text-anchor="middle">{n.label}{ver && <tspan class="tick"> ✓</tspan>}</text>
                  {m.wattage != null && <text class="cstyle" x={box.cx} y={box.y + 24} text-anchor="middle">{`${m.wattage} W`}</text>}
                </a>
              );
            })}
          </g>
        ))}

        <!-- documented cross-family derivation arrows (drawn last, above the lanes) -->
        {drawnArrows.map((e) => (
          <g class="edge" data-edge={`${e.parent}->${e.child}`}>
            <path class="lead" d={e.d} fill="none" />
            <polygon class="head" points={e.head} />
            {e.capLines.length > 0 && (
              <g class="cap" transform={`translate(${e.lx.toFixed(1)} ${e.ly.toFixed(1)})`}>
                <rect x={-e.capW / 2} y={-e.capH / 2} width={e.capW} height={e.capH} rx="4" />
                {e.capLines.map((l, i) => (
                  <text x="0" y={-e.capH / 2 + 6 + i * 12 + 5} text-anchor="middle">{l}</text>
                ))}
              </g>
            )}
          </g>
        ))}
      </svg>
    </div>
    <div class="legend">
      <span class="lg"><span class="sw doc"></span>Documented circuit — links its page</span>
      <span class="lg"><span class="sw ghost"></span>History-tier model — links its family history</span>
      <span class="lg"><span class="sw-span"></span>Chip sits at the era introduced · bar spans the production years</span>
      <span class="lg"><span class="sw-succ"></span>Succession within a family</span>
      <span class="lg"><span class="sw-arrow"></span>Documented derivation between families</span>
    </div>
    <figcaption>
      <strong>Two connectors, two claims.</strong> A <em>succession line</em> joins the models
      inside one family in date order — it records the chain of revisions that carried the line's
      name, not that each step is a documented derivation of the last. An <em>arrow</em> is drawn
      only where an amp's own metadata records a derivation across family lines. The chart draws
      {' '}{arrowWord}: {arrowList}. Each arrow's caption reads the change straight from the two
      circuits' data — the power tubes and rectifier where those differ, the output rating where
      they do not. Within-family documented derivations
      (the 5E1 Champ to the 5F1, the JTM45 to the model 1987) are carried by the succession line
      rather than double-drawn as arrows. Each chip sits at its model's introduction year and its
      bar runs to the end of production{compressed && <>; the era axis compresses to the right of
      the {BREAK} gridline — the tick steps widen from five years to ten there — so the few late
      chapters that reach the 1990s do not squeeze the crowded 1946–1968 core where the corpus
      lives</>}. Outline chips are history-tier models — placed and
      sourced, their circuits not yet drawn — so each family reads as a complete chain even where
      only one or two circuits are documented; the gaps are honest, and an outline chip becomes
      solid when its circuit lands. A chip with no second line is a model whose family file
      states no wattage.
    </figcaption>
  </figure>
</div>
</Base>

<style>
  .page-head{padding:60px 0 8px}
  .eyebrow{font-family:var(--disp);text-transform:uppercase;letter-spacing:.26em;font-size:12.5px;color:var(--amber)}
  h1{font-size:clamp(30px,5vw,50px);line-height:1.05;margin:12px 0 16px;letter-spacing:.05em}
  .lede{max-width:70ch;color:var(--muted);font-size:16.5px}
  .lede strong{color:var(--ink)}
  .lede em{color:var(--muted);font-style:italic}
  .fig{margin:26px 0 0}
  .scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--well);padding:8px 8px 4px}
  .tree{display:block;width:100%;min-width:1040px;height:auto}
  .legend{display:flex;gap:20px;flex-wrap:wrap;margin:14px 2px 0;color:var(--faint);font-size:12px}
  .legend .lg{display:inline-flex;align-items:center;gap:7px}
  .legend .sw{width:22px;height:13px;border-radius:3px;display:inline-block}
  .legend .sw.doc{background:var(--panel);border:1.3px solid var(--amber-dim)}
  .legend .sw.ghost{background:transparent;border:1.3px dashed var(--faint)}
  .legend .sw-span{width:22px;height:0;border-top:1.8px solid var(--line);display:inline-block;position:relative}
  .legend .sw-span::after{content:"";position:absolute;right:-2px;top:-3.5px;width:5px;height:5px;border-radius:50%;background:var(--faint)}
  .legend .sw-succ{width:22px;height:0;border-top:1.6px dotted var(--muted);display:inline-block}
  .legend .sw-arrow{width:22px;height:0;border-top:2px solid var(--amber-dim);display:inline-block;position:relative}
  .legend .sw-arrow::after{content:"▸";position:absolute;right:-4px;top:-9px;color:var(--amber-dim);font-size:11px}
  figcaption{color:var(--faint);font-size:12.5px;line-height:1.6;margin:14px 2px 0;max-width:104ch}
  figcaption strong{color:var(--muted)}
  figcaption em{color:var(--muted);font-style:italic}

  /* --- SVG element styling (scoped; applies to build-time markup) --- */
  .tree .fam{transition:opacity .12s ease}
  .tree:has(.fam:hover) .fam:not(:hover){opacity:.24}

  .tree .grid line{stroke:var(--line-soft);stroke-width:1}
  .tree .grid line.axis{stroke:var(--line);stroke-width:1.5}
  .tree .yr{fill:var(--faint);font-family:var(--mono);font-size:11px;text-anchor:middle}

  .tree .band-bg{fill:var(--panel);opacity:.35}
  .tree .band-bg.alt{fill:var(--panel);opacity:.16}
  .tree .lane{fill:var(--faint);font-family:var(--disp);text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:600}

  .tree .succ{stroke:var(--muted);stroke-width:1.5;stroke-dasharray:1.5 3.5;opacity:.55;stroke-linecap:round}

  .tree .edge .lead{stroke:var(--amber);stroke-width:2}
  .tree .edge .head{fill:var(--amber)}
  .tree .edge .cap rect{fill:var(--well);stroke:var(--line);stroke-width:1}
  .tree .edge .cap text{fill:var(--muted);font-family:var(--mono);font-size:10px}

  .tree .node{cursor:pointer}
  .tree .node .span{stroke:var(--line);stroke-width:1.8;stroke-linecap:round}
  .tree .node .span-end{fill:var(--faint)}
  .tree .node .cstyle{fill:var(--muted);font-family:var(--body);font-size:9px}
  /* documented = solid chip; history-tier = outline (dashed) chip */
  .tree .node.doc .chip{fill:var(--panel);stroke:var(--amber-dim);stroke-width:1.3}
  .tree .node.doc .cid{fill:var(--ink);font-family:var(--disp);text-transform:uppercase;letter-spacing:.03em;font-size:13px;font-weight:600}
  .tree .node.ghost .chip{fill:none;stroke:var(--faint);stroke-width:1.2;stroke-dasharray:4 3}
  .tree .node.ghost .cid{fill:var(--muted);font-family:var(--disp);text-transform:uppercase;letter-spacing:.03em;font-size:12px;font-weight:600}
  .tree .node .cid .tick{fill:var(--ok);font-size:10px}
  .tree .node:hover .chip,.tree .node:focus-visible .chip{stroke:var(--amber);stroke-width:1.8}
  .tree .node:hover .cid,.tree .node:focus-visible .cid{fill:var(--amber)}
  .tree .node:hover .span,.tree .node:focus-visible .span{stroke:var(--amber-dim)}
</style>
