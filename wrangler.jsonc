{
  // Circuit Codex — static site deployment (Cloudflare Workers static assets)
  // The site is generated by Astro from the corpus data in amps/ and models/:
  // wrangler's custom build runs it automatically on `wrangler deploy`
  // (which is also what Workers Builds runs on every push to main).
  // Only main may deploy to production. In the dashboard, Settings > Build > Branch
  // control: production branch = main; other branches must not run `wrangler deploy`
  // (until 2026-09-29 they did, and unmerged PRs were served on circuitcodex.com).
  // Each build stamps /version.json with its revision; .github/workflows/
  // production-revision.yml fails when production is not serving main.
  // Local: cd site && npm run dev   ·   Deploy: npx wrangler deploy
  "name": "circuit-codex",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-18",
  "build": {
    "command": "cd site && npm ci && npm run build",
    "watch_dir": "site/src"
  },
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
