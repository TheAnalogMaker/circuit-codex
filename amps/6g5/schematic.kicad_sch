  (text "56k/10k dropper — illustrative; BP3/BDRV/BD are driven anchors (see header). The driver rail sits above the reservoir this chain hangs from, so no tap off it is drawn." (at 12.7 290.447 0)
    (effects (font (size 1.2 1.2)) (justify left)) (uuid "cfd92d3f-009a-5892-b942-1e95f96cccd7"))
